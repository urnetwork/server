+
+type DateKey = int
+
+func DatetimeStringToDateKey(datetime string) (DateKey, error) {
+	t, err := time.Parse("yyyy-mm-dd", datetime)
+	if err != nil {
+		return 0, err
+	}
+
+	// days since the epoch
+	return (t.UnixMilli() * time.Millisecond) / (24 * time.Hour)
+}
