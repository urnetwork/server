# User-approved scope: any file in the ten locked competition repositories,
# except the trusted simulator/evaluator/scorer/containment instrument below.
# Mono-root patch validation, offline application and multi-repository promotion
# still require their own correctness/build/runtime qualification before enablement.
# Repository metadata (.git/.hg/.svn at every depth) is independently forbidden.
# The frozen Stage A/reference policies remain unchanged and server-relative.
patch_policy:
  max_patch_bytes: 262144
  path_base: mono_root_v1
  allowed_paths:
    - server/**
    - connect/**
    - sdk/**
    - proxy/**
    - glog/**
    - goidenticons/**
    - userwireguard/**
    - sn/**
    - warp/**
    - gvisor/**
  forbidden_paths:
    - server/connect/sim-latency/**

