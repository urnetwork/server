+// Owner cancellation wins while the real production timer is durably blocked.
+func TestConnectH1UserWritePacingProductionTimerCancelsWithoutAdvancingTime(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		defer cancel()
+		settings := &ConnectHandlerSettings{H1UserWriteDelayPerByte: time.Microsecond}
+		start := time.Now()
+		message, witness := newConnectH1PacingTestMessage(64, 1)
+		deadlineEvents := make(chan time.Time, connectH1WriteBatchMaxMessageCount)
+		writeEvents := make(chan connectH1PacingTestWriteEvent, connectH1WriteBatchMaxMessageCount)
+		sentEvents := make(chan ByteCount, connectH1WriteBatchMaxMessageCount)
+		writer := &connectH1PacingTestWriter{deadlineEvents: deadlineEvents, writeEvents: writeEvents}
+		finished := make(chan struct{})
+		var open bool
+		var err error
+		sent := 0
+		go func() {
+			defer close(finished)
+			open, err = writeConnectH1UserReadyBatch(ctx, writer, nil, nil, message, true, time.Second,
+				func(value ByteCount) {
+					sent++
+					sentEvents <- value
+				}, settings)
+		}()
+		synctest.Wait()
+		select {
+		case deadline := <-deadlineEvents:
+			if !deadline.Equal(start.Add(time.Second)) {
+				t.Fatal("production timer changed its original write deadline")
+			}
+		default:
+			t.Fatal("production timer did not enter its pending wait")
+		}
+		checkConnectH1PacingNoEvents(t, writeEvents, sentEvents)
+		cancel()
+		synctest.Wait()
+		select {
+		case <-finished:
+		default:
+			t.Fatal("production timer retained a canceled writer")
+		}
+		if err != nil || open || !time.Now().Equal(start) || len(writer.messages) != 0 || sent != 0 ||
+			len(writer.deadlines) != 1 || !writer.deadlines[0].Equal(start.Add(time.Second)) {
+			t.Fatal("production timer cancellation changed quiet-close semantics", err)
+		}
+		checkConnectH1PacingReleased(t, witness)
+	})
+}
