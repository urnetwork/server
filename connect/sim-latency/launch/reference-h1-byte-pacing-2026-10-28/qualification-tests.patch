+// The historical invalid-frame filter cannot add delay or success accounting.
+func TestConnectH1UserWritePacingChargesOnlyEmittedFrames(t *testing.T) {
+	settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+	first, firstWitness := newConnectH1PacingTestMessage(64, 1)
+	skipped, skippedWitness := newConnectH1PacingTestMessage(16, 2)
+	receive := make(chan []byte, 1)
+	receive <- skipped
+	writer := &connectH1PacingTestWriter{}
+	delegated := &connectH1PacingFramedTestWriter{connectH1PacingTestWriter: writer}
+	sent := 0
+	_, err := writeConnectH1UserReadyBatch(t.Context(), delegated, nil, receive, first, true, time.Second,
+		func(value ByteCount) {
+			if value != 64 {
+				t.Fatal("skipped frame entered accounting")
+			}
+			sent++
+		}, settings)
+	if err != nil || len(clock.waits) != 1 || clock.waits[0] != 64*time.Microsecond ||
+		len(writer.messages) != 1 || sent != 1 {
+		t.Fatal("skipped frame entered pacing or output", err)
+	}
+	checkConnectH1PacingReleased(t, firstWitness, skippedWitness)
+}
