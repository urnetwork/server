+// With no hooks, a byte delay longer than the socket budget cannot start a timer.
+func TestConnectH1UserWritePacingProductionClockRefusesInsufficientWriteBudget(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		settings := &ConnectHandlerSettings{H1UserWriteDelayPerByte: time.Microsecond}
+		start := time.Now()
+		message, witness := newConnectH1PacingTestMessage(64, 1)
+		writer := &connectH1PacingTestWriter{}
+		open, err := writeConnectH1UserReadyBatch(t.Context(), writer, nil, nil, message, true,
+			32*time.Microsecond, nil, settings)
+		if !errors.Is(err, context.DeadlineExceeded) || open || !time.Now().Equal(start) ||
+			len(writer.messages) != 0 || len(writer.deadlines) != 1 ||
+			!writer.deadlines[0].Equal(start.Add(32*time.Microsecond)) {
+			t.Fatal("production clock extended an insufficient write budget", err)
+		}
+		checkConnectH1PacingReleased(t, witness)
+	})
+}
