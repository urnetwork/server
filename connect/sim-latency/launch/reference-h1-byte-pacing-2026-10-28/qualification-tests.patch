+// Existing socket failures keep their errors, no success accounting and exact pool release.
+func TestConnectH1UserWritePacingSocketFailuresReturnOwners(t *testing.T) {
+	for _, stage := range []string{"deadline", "frame", "flush", "framed"} {
+		settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+		first, firstWitness := newConnectH1PacingTestMessage(64, 1)
+		second, secondWitness := newConnectH1PacingTestMessage(64, 2)
+		receive := make(chan []byte, 1)
+		receive <- second
+		failure := errors.New("synthetic delegated socket failure")
+		writer := &connectH1PacingTestWriter{}
+		boundary := &connectH1BatchTestBoundary{}
+		var delegated connectH1WebSocketWriter = writer
+		var batch connectH1WriteBatch = boundary
+		switch stage {
+		case "deadline":
+			writer.deadlineErr = failure
+		case "frame":
+			writer.frameErr = failure
+		case "flush":
+			boundary.flushErr = failure
+		case "framed":
+			writer.framedErr = failure
+			delegated = &connectH1PacingFramedTestWriter{connectH1PacingTestWriter: writer}
+			batch = nil
+		}
+		sent := 0
+		_, err := writeConnectH1UserReadyBatch(t.Context(), delegated, batch, receive, first, true, time.Second,
+			func(ByteCount) { sent++ }, settings)
+		if !errors.Is(err, failure) || sent != 0 || len(writer.deadlines) != 1 {
+			t.Fatalf("socket stage %s changed its failure/accounting: %v", stage, err)
+		}
+		if stage == "deadline" && len(clock.waits) != 0 || stage != "deadline" && len(clock.waits) != 1 {
+			t.Fatalf("socket stage %s reached the wrong wait boundary", stage)
+		}
+		if (stage == "frame" || stage == "flush") && boundary.abortCount != 1 {
+			t.Fatalf("socket stage %s did not abort its retained batch", stage)
+		}
+		checkConnectH1PacingReleased(t, firstWitness, secondWitness)
+	}
+}
