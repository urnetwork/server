+// The existing handler join cannot publish idle while its pacing owner is held.
+func TestConnectH1UserWritePacingShutdownJoinsHeldOwner(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancel(t.Context())
+		defer cancel()
+		settings, _ := newConnectH1PacingTestSettings(time.Microsecond)
+		entered := make(chan struct{})
+		cancellationSeen := make(chan struct{})
+		release := make(chan struct{})
+		var releaseOnce sync.Once
+		releaseWait := func() { releaseOnce.Do(func() { close(release) }) }
+		defer releaseWait()
+		settings.h1UserWriteWaitForTest = func(ctx context.Context, duration time.Duration) error {
+			close(entered)
+			<-ctx.Done()
+			close(cancellationSeen)
+			<-release
+			return ctx.Err()
+		}
+		beforeCount := clientconnect.MessagePoolOutstandingCount()
+		beforeBytes := clientconnect.MessagePoolOutstandingByteCount()
+		beforeViolations := clientconnect.MessagePoolViolationCount()
+		message, witnessWhileHeld := newConnectH1PacingTestMessage(64, 1)
+		writer := &connectH1PacingTestWriter{}
+		var workers connectHandlerWorkers
+		writerFinished := make(chan struct{})
+		var open bool
+		var err error
+		sent := 0
+		workers.start(func() {
+			defer close(writerFinished)
+			open, err = writeConnectH1UserReadyBatch(ctx, writer, nil, nil, message, true, time.Second,
+				func(ByteCount) { sent++ }, settings)
+		})
+		synctest.Wait()
+		select {
+		case <-entered:
+		default:
+			t.Fatal("writer did not enter controlled wait")
+		}
+		stopEntered := make(chan struct{})
+		finished := make(chan struct{})
+		go func() {
+			finishH1ConnectHandlerWorkers(&workers, func() {
+				cancel()
+				close(stopEntered)
+			})
+			close(finished)
+		}()
+		// The writer is blocked on release and the finisher must be blocked on
+		// its join. An erroneous early return is settled before either assertion.
+		synctest.Wait()
+		select {
+		case <-stopEntered:
+		default:
+			t.Fatal("handler finisher did not stop the connection")
+		}
+		select {
+		case <-cancellationSeen:
+		default:
+			t.Fatal("owned wait did not observe handler cancellation")
+		}
+		// There is exactly one witness besides the product owner: a premature
+		// product return would make this the final return, which must fail here.
+		if clientconnect.MessagePoolReturn(witnessWhileHeld) {
+			t.Fatal("held writer released its product owner before explicit release")
+		}
+		select {
+		case <-writerFinished:
+			t.Fatal("held writer returned before its explicit release")
+		default:
+		}
+		select {
+		case <-finished:
+			t.Fatal("handler published idle before its held writer joined")
+		default:
+		}
+		releaseWait()
+		synctest.Wait()
+		select {
+		case <-finished:
+		default:
+			t.Fatal("handler did not join the released pacing owner")
+		}
+		select {
+		case <-writerFinished:
+		default:
+			t.Fatal("handler join preceded writer completion")
+		}
+		if err != nil || open || len(writer.messages) != 0 || sent != 0 {
+			t.Fatal("shutdown emitted a new user frame or changed quiet close", err)
+		}
+		if clientconnect.MessagePoolOutstandingCount() != beforeCount ||
+			clientconnect.MessagePoolOutstandingByteCount() != beforeBytes ||
+			clientconnect.MessagePoolViolationCount() != beforeViolations {
+			t.Fatal("joined shutdown retained a test-owned root or violated pool ownership")
+		}
+	})
+}
