+// Cancellation before pacing retains the helper's historical quiet-close result.
+func TestConnectH1UserWritePacingCanceledBeforeWriteIsQuiet(t *testing.T) {
+	settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+	ctx, cancel := context.WithCancel(t.Context())
+	cancel()
+	message, witness := newConnectH1PacingTestMessage(64, 1)
+	writer := &connectH1PacingTestWriter{}
+	open, err := writeConnectH1UserReadyBatch(ctx, writer, nil, nil, message, true, time.Second, nil, settings)
+	if err != nil || open || len(writer.messages) != 0 || len(writer.deadlines) != 0 || len(clock.waits) != 0 {
+		t.Fatal("canceled owner entered the socket path", err)
+	}
+	checkConnectH1PacingReleased(t, witness)
+}
