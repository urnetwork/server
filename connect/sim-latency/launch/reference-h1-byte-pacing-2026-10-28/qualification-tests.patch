+// One held writer does not block a zero-wait receiver offer or another writer.
+func TestConnectH1UserWritePacingIsolatesReceiverAndSibling(t *testing.T) {
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	settings, _ := newConnectH1PacingTestSettings(time.Microsecond)
+	entered := make(chan struct{})
+	settings.h1UserWriteWaitForTest = func(ctx context.Context, duration time.Duration) error {
+		close(entered)
+		<-ctx.Done()
+		return ctx.Err()
+	}
+	message, witness := newConnectH1PacingTestMessage(64, 1)
+	receive := make(chan []byte, 1)
+	writer := &connectH1PacingTestWriter{}
+	finished := make(chan error, 1)
+	go func() {
+		_, err := writeConnectH1UserReadyBatch(ctx, writer, nil, receive, message, true, time.Second, nil, settings)
+		finished <- err
+	}()
+	select {
+	case <-entered:
+	case <-t.Context().Done():
+		t.Fatal("writer did not reach its controlled pacing wait")
+	}
+	queued, queuedWitness := newConnectH1PacingTestMessage(64, 2)
+	select {
+	case receive <- queued:
+	default:
+		t.Fatal("held writer blocked independent receiver capacity")
+	}
+	refused, refusedWitness := newConnectH1PacingTestMessage(64, 3)
+	select {
+	case receive <- refused:
+		t.Fatal("bounded receive queue admitted beyond its capacity")
+	default:
+		clientconnect.MessagePoolReturn(refused)
+	}
+	siblingSettings, siblingClock := newConnectH1PacingTestSettings(time.Microsecond)
+	sibling, siblingWitness := newConnectH1PacingTestMessage(64, 4)
+	siblingWriter := &connectH1PacingTestWriter{}
+	open, err := writeConnectH1UserReadyBatch(t.Context(), siblingWriter, nil, nil, sibling, true, time.Second, nil, siblingSettings)
+	if err != nil || !open || len(siblingWriter.messages) != 1 || len(siblingClock.waits) != 1 {
+		t.Fatal("held writer stalled an independent sibling", err)
+	}
+	cancel()
+	if err := <-finished; err != nil || len(writer.messages) != 0 {
+		t.Fatal("held writer did not quietly join cancellation", err)
+	}
+	clientconnect.MessagePoolReturn(<-receive)
+	checkConnectH1PacingReleased(t, witness, queuedWitness, refusedWitness, siblingWitness)
+}
