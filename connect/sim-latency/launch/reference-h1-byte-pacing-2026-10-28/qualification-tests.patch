+// Qualification-only synthetic tests pin byte pacing, deadlines, cancellation,
+// pooled ownership and per-writer isolation without making timed observations.
+package connect
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"math"
+	"strings"
+	"sync"
+	"testing"
+	"testing/synctest"
+	"time"
+
+	clientconnect "github.com/urnetwork/connect"
+)
+
+// One test writer owns this clock; barriers synchronize any external observer.
+type connectH1PacingTestClock struct {
+	now   time.Time
+	waits []time.Duration
+}
+
+// Reads synthetic monotonic progress without consulting the host clock.
+func (self *connectH1PacingTestClock) readTime() time.Time { return self.now }
+
+// Advances only the supplied virtual duration, never a real-time sleep.
+func (self *connectH1PacingTestClock) wait(ctx context.Context, duration time.Duration) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	self.waits = append(self.waits, duration)
+	self.now = self.now.Add(duration)
+	return nil
+}
+
+// Hooks remain instance-local and are never part of a scored patch setting.
+func newConnectH1PacingTestSettings(delay time.Duration) (*ConnectHandlerSettings, *connectH1PacingTestClock) {
+	clock := &connectH1PacingTestClock{now: time.Unix(1000, 0).UTC()}
+	return &ConnectHandlerSettings{
+		H1UserWriteDelayPerByte: delay,
+		h1UserWriteNowForTest:   clock.readTime,
+		h1UserWriteWaitForTest:  clock.wait,
+	}, clock
+}
+
+// Records complete delegated messages and can fail the unchanged socket stages.
+// One worker mutates it. Live observations use immutable channel events; slices
+// and counters are inspected only after that worker's completion is received.
+type connectH1PacingTestWriter struct {
+	deadlines      []time.Time
+	messages       [][]byte
+	frameCalls     int
+	deadlineErr    error
+	frameErr       error
+	framedErr      error
+	framedCalls    int
+	deadlineEvents chan time.Time
+	writeEvents    chan connectH1PacingTestWriteEvent
+	writeRelease   <-chan struct{}
+}
+
+// Records entry to delegated I/O without sharing the writer's mutable storage.
+type connectH1PacingTestWriteEvent struct {
+	at           time.Time
+	messageCount int
+	byteCount    int
+}
+
+// Records the original absolute deadline even when the delegated setter fails.
+func (self *connectH1PacingTestWriter) SetWriteDeadline(deadline time.Time) error {
+	self.deadlines = append(self.deadlines, deadline)
+	if self.deadlineEvents != nil {
+		self.deadlineEvents <- deadline
+	}
+	return self.deadlineErr
+}
+
+// An optional release gates fake I/O after publishing its immutable entry.
+func (self *connectH1PacingTestWriter) observeWrite(messageCount int, byteCount int) {
+	if self.writeEvents != nil {
+		self.writeEvents <- connectH1PacingTestWriteEvent{
+			at: time.Now(), messageCount: messageCount, byteCount: byteCount,
+		}
+	}
+	if self.writeRelease != nil {
+		<-self.writeRelease
+	}
+}
+
+// Records the WebSocket branch independently from the framed batch branch.
+func (self *connectH1PacingTestWriter) WriteMessage(messageType int, message []byte) error {
+	self.observeWrite(1, len(message))
+	self.frameCalls++
+	if self.frameErr != nil {
+		return self.frameErr
+	}
+	self.messages = append(self.messages, bytes.Clone(message))
+	return nil
+}
+
+// Adds only the optional framed operation to the common recording writer.
+type connectH1PacingFramedTestWriter struct {
+	*connectH1PacingTestWriter
+}
+
+// A framed failure publishes no successful user accounting.
+func (self *connectH1PacingFramedTestWriter) WriteMessages(messages [][]byte) error {
+	byteCount := 0
+	for _, message := range messages {
+		byteCount += len(message)
+	}
+	self.observeWrite(len(messages), byteCount)
+	self.framedCalls++
+	if self.framedErr != nil {
+		return self.framedErr
+	}
+	for _, message := range messages {
+		self.messages = append(self.messages, bytes.Clone(message))
+	}
+	return nil
+}
+
+// The caller hands the original to the production helper and retains one share.
+func newConnectH1PacingTestMessage(size int, value byte) ([]byte, []byte) {
+	message := clientconnect.MessagePoolGet(size)
+	for i := range message {
+		message[i] = value
+	}
+	return message, clientconnect.MessagePoolShareReadOnly(message)
+}
+
+// Returning the final share proves the production helper returned its owner.
+func checkConnectH1PacingReleased(t *testing.T, witnesses ...[]byte) {
+	t.Helper()
+	for index, witness := range witnesses {
+		if !clientconnect.MessagePoolReturn(witness) {
+			t.Fatalf("synthetic message %d retained production ownership", index)
+		}
+	}
+}
+
+// Callers first settle their bubble. Channel observations remain safe when a
+// later timer wake resumes the writer; elapsed virtual time alone is not a join.
+func checkConnectH1PacingNoEvents(t *testing.T, writes <-chan connectH1PacingTestWriteEvent, sent <-chan ByteCount) {
+	t.Helper()
+	select {
+	case event := <-writes:
+		t.Fatalf("delegated user write entered too early at %v for %d bytes", event.at, event.byteCount)
+	default:
+	}
+	select {
+	case value := <-sent:
+		t.Fatalf("successful user accounting published too early for %d bytes", value)
+	default:
+	}
+}
+
+// The scored default is exact; no process-wide pacing object is constructed.
+func TestConnectH1UserWritePacingDefaultIsOneMicrosecondPerByte(t *testing.T) {
+	first := DefaultConnectHandlerSettings()
+	second := DefaultConnectHandlerSettings()
+	if first.H1UserWriteDelayPerByte != time.Microsecond || second.H1UserWriteDelayPerByte != time.Microsecond {
+		t.Fatal("fixed byte-delay default changed")
+	}
+	first.H1UserWriteDelayPerByte = 0
+	if second.H1UserWriteDelayPerByte != time.Microsecond || first.h1UserWriteNowForTest != nil ||
+		first.h1UserWriteWaitForTest != nil || second.h1UserWriteNowForTest != nil || second.h1UserWriteWaitForTest != nil {
+		t.Fatal("default settings shared mutable pacing state or test hooks")
+	}
+}
