+// The production timer path uses only bubble time, with both test hooks nil.
+func TestConnectH1UserWritePacingProductionTimerCompletesAtExactDelay(t *testing.T) {
+	for _, framed := range []bool{false, true} {
+		synctest.Test(t, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(t.Context())
+			defer cancel()
+			settings := &ConnectHandlerSettings{H1UserWriteDelayPerByte: time.Microsecond}
+			start := time.Now()
+			first, firstWitness := newConnectH1PacingTestMessage(64, 1)
+			second, secondWitness := newConnectH1PacingTestMessage(96, 2)
+			receive := make(chan []byte, 1)
+			receive <- second
+			deadlineEvents := make(chan time.Time, connectH1WriteBatchMaxMessageCount)
+			writeEvents := make(chan connectH1PacingTestWriteEvent, connectH1WriteBatchMaxMessageCount)
+			sentEvents := make(chan ByteCount, connectH1WriteBatchMaxMessageCount)
+			release := make(chan struct{})
+			var releaseOnce sync.Once
+			releaseWrite := func() { releaseOnce.Do(func() { close(release) }) }
+			defer releaseWrite()
+			writer := &connectH1PacingTestWriter{
+				deadlineEvents: deadlineEvents, writeEvents: writeEvents, writeRelease: release,
+			}
+			var delegated connectH1WebSocketWriter = writer
+			var boundary connectH1WriteBatch = &connectH1BatchTestBoundary{}
+			if framed {
+				delegated = &connectH1PacingFramedTestWriter{connectH1PacingTestWriter: writer}
+				boundary = nil
+			}
+			finished := make(chan struct{})
+			var open bool
+			var err error
+			sent := 0
+			go func() {
+				defer close(finished)
+				open, err = writeConnectH1UserReadyBatch(ctx, delegated, boundary, receive, first, true, time.Second,
+					func(value ByteCount) {
+						sent++
+						sentEvents <- value
+					}, settings)
+			}()
+			synctest.Wait()
+			select {
+			case deadline := <-deadlineEvents:
+				if !deadline.Equal(start.Add(time.Second)) {
+					t.Fatal("production timer changed its original write deadline")
+				}
+			default:
+				t.Fatal("production timer did not publish its original write deadline")
+			}
+			if !time.Now().Equal(start) {
+				t.Fatal("settling the pending timer advanced virtual time")
+			}
+			checkConnectH1PacingNoEvents(t, writeEvents, sentEvents)
+			time.Sleep(159 * time.Microsecond)
+			synctest.Wait()
+			checkConnectH1PacingNoEvents(t, writeEvents, sentEvents)
+			time.Sleep(time.Microsecond)
+			synctest.Wait()
+			select {
+			case event := <-writeEvents:
+				wantMessages, wantBytes := 1, 64
+				if framed {
+					wantMessages, wantBytes = 2, 160
+				}
+				if !event.at.Equal(start.Add(160*time.Microsecond)) || event.messageCount != wantMessages || event.byteCount != wantBytes {
+					t.Fatal("production timer reached delegated I/O at the wrong instant or byte boundary")
+				}
+			default:
+				t.Fatal("production timer did not enter delegated I/O at the exact byte delay")
+			}
+			select {
+			case value := <-sentEvents:
+				t.Fatalf("blocked delegated I/O published %d successful bytes", value)
+			default:
+			}
+			select {
+			case <-finished:
+				t.Fatal("writer returned before its controlled delegated I/O released")
+			default:
+			}
+			releaseWrite()
+			synctest.Wait()
+			select {
+			case <-finished:
+			default:
+				t.Fatal("production timer did not complete at the exact byte delay")
+			}
+			if err != nil || !open || time.Since(start) != 160*time.Microsecond || sent != 2 ||
+				len(writer.messages) != 2 || len(writer.deadlines) != 1 ||
+				!writer.deadlines[0].Equal(start.Add(time.Second)) ||
+				!bytes.Equal(writer.messages[0], bytes.Repeat([]byte{1}, 64)) ||
+				!bytes.Equal(writer.messages[1], bytes.Repeat([]byte{2}, 96)) {
+				t.Fatal("production timer changed bytes, accounting or deadline", err)
+			}
+			checkConnectH1PacingReleased(t, firstWitness, secondWitness)
+		})
+	}
+}
