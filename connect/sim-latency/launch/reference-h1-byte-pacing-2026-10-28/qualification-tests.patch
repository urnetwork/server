+// Legal small user frames accumulate the four-MiB arithmetic entirely virtually.
+func TestConnectH1UserWritePacingFourMiBHasExactAdditionalService(t *testing.T) {
+	settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+	start := clock.now
+	writer := &connectH1PacingTestWriter{}
+	for index := 0; index < 1024; index++ {
+		message, witness := newConnectH1PacingTestMessage(4*1024, byte(index))
+		before := clock.now
+		open, err := writeConnectH1UserReadyBatch(t.Context(), writer, nil, nil, message, true, time.Second, nil, settings)
+		if err != nil || !open || !writer.deadlines[index].Equal(before.Add(time.Second)) {
+			t.Fatal("virtual paced frame changed its original deadline", err)
+		}
+		checkConnectH1PacingReleased(t, witness)
+	}
+	if got := clock.now.Sub(start); got != 4194304*time.Microsecond || len(clock.waits) != 1024 {
+		t.Fatalf("virtual four-MiB service=%v waits=%d", got, len(clock.waits))
+	}
+	for _, delay := range clock.waits {
+		if delay != 4096*time.Microsecond {
+			t.Fatal("user-frame delay is not proportional to exact byte count")
+		}
+	}
+}
