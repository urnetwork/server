+// An unwrapped writer remains singleton and does not consume the next owner.
+func TestConnectH1UserWritePacingSingletonRetainsQueuedSibling(t *testing.T) {
+	settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+	first, firstWitness := newConnectH1PacingTestMessage(64, 1)
+	second, secondWitness := newConnectH1PacingTestMessage(96, 2)
+	receive := make(chan []byte, 1)
+	receive <- second
+	writer := &connectH1PacingTestWriter{}
+	open, err := writeConnectH1UserReadyBatch(t.Context(), writer, nil, receive, first, true, time.Second, nil, settings)
+	if err != nil || !open || len(writer.messages) != 1 || len(clock.waits) != 1 || clock.waits[0] != 64*time.Microsecond {
+		t.Fatal("singleton pacing consumed another ready frame", err)
+	}
+	select {
+	case pending := <-receive:
+		if len(pending) != 96 || pending[0] != 2 {
+			t.Fatal("singleton changed its queued sibling")
+		}
+		clientconnect.MessagePoolReturn(pending)
+	default:
+		t.Fatal("singleton dequeued its sibling")
+	}
+	checkConnectH1PacingReleased(t, firstWitness, secondWitness)
+}
