+// Both encodings pass through the same paced ownership and accounting boundary.
+func checkConnectH1PacingEncoding(t *testing.T, framed bool) {
+	t.Helper()
+	settings, clock := newConnectH1PacingTestSettings(time.Microsecond)
+	start := clock.now
+	first, firstWitness := newConnectH1PacingTestMessage(64, 1)
+	second, secondWitness := newConnectH1PacingTestMessage(96, 2)
+	receive := make(chan []byte, 1)
+	receive <- second
+	writer := &connectH1PacingTestWriter{}
+	var delegated connectH1WebSocketWriter = writer
+	var boundary connectH1WriteBatch
+	batch := &connectH1BatchTestBoundary{}
+	if framed {
+		delegated = &connectH1PacingFramedTestWriter{connectH1PacingTestWriter: writer}
+	} else {
+		boundary = batch
+	}
+	var sent []ByteCount
+	open, err := writeConnectH1UserReadyBatch(t.Context(), delegated, boundary, receive, first, true, time.Second,
+		func(value ByteCount) { sent = append(sent, value) }, settings)
+	if err != nil || !open || len(writer.messages) != 2 || len(sent) != 2 || sent[0] != 64 || sent[1] != 96 {
+		t.Fatal("paced encoding changed complete accounting", err)
+	}
+	if !bytes.Equal(writer.messages[0], bytes.Repeat([]byte{1}, 64)) ||
+		!bytes.Equal(writer.messages[1], bytes.Repeat([]byte{2}, 96)) {
+		t.Fatal("paced encoding changed ordered user bytes")
+	}
+	if len(clock.waits) != 1 || clock.waits[0] != 160*time.Microsecond ||
+		len(writer.deadlines) != 1 || !writer.deadlines[0].Equal(start.Add(time.Second)) {
+		t.Fatal("paced encoding refreshed its deadline or charged the wrong bytes")
+	}
+	if framed && (writer.framedCalls != 1 || writer.frameCalls != 0) {
+		t.Fatal("framed pacing fell through to WebSocket writes")
+	}
+	if !framed && (writer.frameCalls != 2 || batch.beginCount != 1 || batch.flushCount != 1 || batch.abortCount != 0) {
+		t.Fatal("WebSocket pacing changed batch flush semantics")
+	}
+	checkConnectH1PacingReleased(t, firstWitness, secondWitness)
+}
+
+// The ordinary WebSocket batch retains FIFO bytes and post-flush accounting.
+func TestConnectH1UserWritePacingWebSocketPreservesBytesAndAccounting(t *testing.T) {
+	checkConnectH1PacingEncoding(t, false)
+}
+
+// The framed writer cannot bypass the byte delay through its fast batch method.
+func TestConnectH1UserWritePacingFramedPreservesBytesAndAccounting(t *testing.T) {
+	checkConnectH1PacingEncoding(t, true)
+}
