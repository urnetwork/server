# Render all placeholders before installation. Not executable shell.
WARP_ENV=main
WARP_SERVICE=competitionworker
WARP_BLOCK=competition
WARP_HOME=/home/by/urnetwork
WARP_VERSION=${ACTUAL_QUALIFIED_CONTROL_RUNTIME_VERSION}
WARP_IMAGE_DIGEST=${ACTUAL_WORKER_OCI_IMAGE_ID}
PATH=${QUALIFIED_GO_BIN_DIRECTORY}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
GOTOOLCHAIN=local
GOMAXPROCS=2
GOFLAGS=-p=2
SIM_LATENCY_PREPARATION_CONFIG=/etc/urnetwork/competition-production-20261028/preparation.json
SIM_LATENCY_QUALIFICATION_CONFIG=/etc/urnetwork/competition-production-20261028/qualification.json
