# Render all placeholders before installation. Do not replace the staging unit.
[Unit]
Description=URnetwork fenced production competition supervisor for October 28
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/urnetwork/competition-production-20261028
EnvironmentFile=/etc/urnetwork/competition-production-20261028/supervisor.env
ExecStart=${QUALIFIED_CONTROL_DIRECTORY}/sim-latency supervise --enable-automation --owner-id=sille-production-20261028 --state-dir=/var/lib/urnetwork/competition-production-20261028/supervisor --source-config=/home/by/urnetwork/config/main/sim-latency.yml --repos-root=/home/by/urnetwork --worker-command=${QUALIFIED_CONTROL_DIRECTORY}/competitionworker --worker-sha256=${QUALIFIED_COMPETITIONWORKER_SHA256} --prepare-command=${QUALIFIED_CONTROL_DIRECTORY}/competitionprepare --prepare-sha256=${QUALIFIED_COMPETITIONPREPARE_SHA256} --review-command=${QUALIFIED_SNOW_REVIEW_WRAPPER} --review-sha256=${QUALIFIED_SNOW_REVIEW_WRAPPER_SHA256} --reviewer-token-file=/etc/urnetwork/competition-production-20261028/reviewer.token --review-api-url=https://api.bringyour.com --build-command=${QUALIFIED_SOURCE_BUILD_WRAPPER} --build-sha256=${QUALIFIED_SOURCE_BUILD_WRAPPER_SHA256}
CPUAffinity=20 22
MemoryMax=12G
KillMode=control-group
TimeoutStopSec=120
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
