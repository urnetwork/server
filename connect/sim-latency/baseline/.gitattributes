# The immutable dataset is authenticated by MANIFEST.sha256. Suppress enormous
# text diffs for raw JSON/CSV/log artifacts while retaining ordinary Git blobs.
v1/** -diff
MANIFEST.sha256 -diff

# Preserve exact native output and unified-diff artifacts; do not normalize evidence.
# Go source files keep their normal whitespace checks.
*.log whitespace=-blank-at-eol
*.patch whitespace=-blank-at-eol,-space-before-tab
