[Unit]
OnFailure=urnetwork-subeval-recovery.service
OnFailureJobMode=replace
Description=Scoped private evaluation engine network guard
Requires=urnetwork-private-engine-network-namespace.service
BindsTo=urnetwork-private-engine-network-namespace.service
After=urnetwork-private-engine-network-namespace.service
JoinsNamespaceOf=urnetwork-private-engine-network-namespace.service
Before=urnetwork-private-containerd.service urnetwork-private-engine.service

[Service]
Type=oneshot
User=root
Group=root
Slice=urnetwork-management-private.slice
UMask=0077
PrivateNetwork=yes
ExecStart=@NFT_PATH@ --file @CONFIG_DIRECTORY@/network.nft
RemainAfterExit=yes
KillMode=control-group
Restart=no
LimitCORE=0
AllowedCPUs=@MANAGEMENT_CPUSET@
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
