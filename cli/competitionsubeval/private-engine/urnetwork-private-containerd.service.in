[Unit]
OnFailure=urnetwork-subeval-recovery.service
OnFailureJobMode=replace
Description=Private bounded evaluation containerd
Requires=urnetwork-private-engine-network.service urnetwork-private-engine-network-namespace.service
BindsTo=urnetwork-private-engine-network-namespace.service
After=urnetwork-private-engine-network.service urnetwork-private-engine-network-namespace.service
JoinsNamespaceOf=urnetwork-private-engine-network-namespace.service
RequiresMountsFor=@BASE_DIRECTORY@/candidate
Before=urnetwork-private-engine.service
ConditionPathIsMountPoint=@BASE_DIRECTORY@/candidate
ConditionPathIsDirectory=/run/containerd

[Service]
Type=notify
User=root
Group=root
Slice=urnetwork-management-private.slice
UMask=0077
PrivateNetwork=yes
BindPaths=@BASE_DIRECTORY@/candidate/exec/containerd-sockets:/run/containerd
Environment="PATH=@ENGINE_BIN@"
Environment="TMPDIR=@BASE_DIRECTORY@/candidate/scratch/engine-tmp"
Environment="DOCKER_TMPDIR=@BASE_DIRECTORY@/candidate/scratch/docker-tmp"
Environment="HOME=@BASE_DIRECTORY@/candidate/scratch/engine-home"
WorkingDirectory=@BASE_DIRECTORY@/candidate
ExecStart=@ENGINE_BIN@/containerd --config @CONFIG_DIRECTORY@/containerd.toml
ExecStartPost=/usr/bin/chmod 0600 @BASE_DIRECTORY@/control/containerd.sock
Delegate=yes
KillMode=control-group
Restart=no
TimeoutStartSec=@ENGINE_START_SECONDS@
TimeoutStopSec=@ENGINE_STOP_SECONDS@
MemoryMax=@ENGINE_MEMORY_MAXIMUM@
CPUQuota=@ENGINE_CPU_QUOTA@
AllowedCPUs=@MANAGEMENT_CPUSET@
TasksMax=@ENGINE_TASKS_MAXIMUM@
LimitNOFILE=@ENGINE_DESCRIPTOR_MAXIMUM@
LimitCORE=0
StandardOutput=append:@BASE_DIRECTORY@/candidate/daemon-logs/containerd.stdout.log
StandardError=append:@BASE_DIRECTORY@/candidate/daemon-logs/containerd.stderr.log

[Install]
WantedBy=multi-user.target
