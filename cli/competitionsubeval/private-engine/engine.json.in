{
  "data-root": "@BASE_DIRECTORY@/candidate/docker",
  "exec-root": "@BASE_DIRECTORY@/candidate/exec/docker",
  "storage-driver": "overlay2",
  "features": {"containerd-snapshotter": false},
  "pidfile": "@BASE_DIRECTORY@/control/dockerd.pid",
  "hosts": ["unix://@BASE_DIRECTORY@/control/docker.sock"],
  "group": "root",
  "containerd": "@BASE_DIRECTORY@/control/containerd.sock",
  "containerd-namespace": "urnetwork-evaluation",
  "containerd-plugins-namespace": "urnetwork-evaluation-plugins",
  "bridge": "none",
  "iptables": false,
  "ip6tables": false,
  "ip-forward": false,
  "ip-masq": false,
  "userland-proxy": false,
  "ipv6": false,
  "userns-remap": "@REMAP_ACCOUNT@:@REMAP_ACCOUNT@",
  "exec-opts": ["native.cgroupdriver=systemd"],
  "default-runtime": "runc",
  "live-restore": false,
  "log-driver": "json-file",
  "log-opts": {"max-size": "@CONTAINER_LOG_MAXIMUM_SIZE@", "max-file": "@CONTAINER_LOG_MAXIMUM_FILES@"}
}
