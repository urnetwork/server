+// Only first-half positives avoid admission. No snapshot survives into slow I/O.
+func (self *residentContractManager) hasWarmSnapshotContract(pair model.TransferPair) bool {
+	snapshot := self.activeSnapshot.Load()
+	if snapshot == nil || self.settings.ContractManagerCheckTimeout <= 0 {
+		return false
+	}
+	entry, ok := snapshot.activeContracts[pair]
+	if !ok {
+		return false
+	}
+	deadline := entry.deadline(self.settings.ContractManagerCheckTimeout)
+	now := time.Now()
+	if !now.Before(entry.checkTime.Add(deadline.Sub(entry.checkTime) / 2)) {
+		return false
+	}
+	if self.beforeSnapshotReturnForTest != nil {
+		self.beforeSnapshotReturnForTest()
+	}
+	return !self.readsClosed.Load() && self.ctx.Err() == nil && time.Now().Before(deadline)
+}
+
+// Owner-locked replacement retains one bounded immutable map, not a history.
+func (self *residentContractManager) publishActiveSnapshotWithLock() {
+	if self.readsClosed.Load() || len(self.activeContracts) == 0 {
+		self.activeSnapshot.Store(nil)
+		return
+	}
+	activeTransferPairEntries := make(map[model.TransferPair]activeContractEntry, len(self.activeContracts))
+	for pair, entry := range self.activeContracts {
+		activeTransferPairEntries[pair] = *entry
+	}
+	self.activeSnapshot.Store(&residentContractSnapshot{activeContracts: activeTransferPairEntries})
+}
