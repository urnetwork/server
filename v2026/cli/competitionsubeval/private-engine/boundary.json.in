{
  "schema": 1,
  "base_directory": "@BASE_DIRECTORY@",
  "candidate_root": "@BASE_DIRECTORY@/candidate",
  "backing_file": "@BACKING_FILE@",
  "block_device": "/dev/loop@LOOP_NUMBER@",
  "maximum_bytes": @MAXIMUM_BYTES@,
  "minimum_free_bytes": @MINIMUM_FREE_BYTES@,
  "minimum_backing_free_bytes": @MINIMUM_BACKING_FREE_BYTES@,
  "private_socket_path": "@BASE_DIRECTORY@/control/docker.sock",
  "containerd_socket_path": "@BASE_DIRECTORY@/control/containerd.sock",
  "docker_data_root": "@BASE_DIRECTORY@/candidate/docker",
  "containerd_root": "@BASE_DIRECTORY@/candidate/containerd",
  "engine_exec_root": "@BASE_DIRECTORY@/candidate/exec",
  "scratch_root": "@BASE_DIRECTORY@/candidate/scratch",
  "work_root": "@BASE_DIRECTORY@/candidate/jobs",
  "user_namespace": "@REMAP_ACCOUNT@",
  "container_root_uid": @CONTAINER_ROOT_UID@,
  "container_root_gid": @CONTAINER_ROOT_GID@,
  "container_id_map_length": @CONTAINER_ID_MAP_LENGTH@,
  "runtime_name": "runc",
  "runtime_arguments": [],
  "management_cpuset": "@MANAGEMENT_CPUSET@",
  "dockerd": {"path": "@ENGINE_BIN@/dockerd", "sha256": "@DOCKERD_SHA256@"},
  "containerd": {"path": "@ENGINE_BIN@/containerd", "sha256": "@CONTAINERD_SHA256@"},
  "containerd_version": "@CONTAINERD_VERSION@",
  "containerd_source_commit": "@CONTAINERD_SOURCE_COMMIT@",
  "containerd_shim": {"path": "@ENGINE_BIN@/containerd-shim-runc-v2", "sha256": "@CONTAINERD_SHIM_SHA256@"},
  "runc": {"path": "@ENGINE_BIN@/runc", "sha256": "@RUNC_SHA256@"},
  "socket_mode_helper": {"path": "/usr/bin/chmod", "sha256": "@CHMOD_SHA256@"},
  "nftables": {"path": "@NFT_PATH@", "sha256": "@NFT_SHA256@"},
  "engine_config": {"path": "@CONFIG_DIRECTORY@/engine.json", "sha256": "@ENGINE_CONFIG_SHA256@"},
  "containerd_config": {"path": "@CONFIG_DIRECTORY@/containerd.toml", "sha256": "@CONTAINERD_CONFIG_SHA256@"},
  "network_policy": {"path": "@CONFIG_DIRECTORY@/network.nft", "sha256": "@NETWORK_POLICY_SHA256@"},
  "namespace_keeper": {"path": "@NAMESPACE_KEEPER_PATH@", "sha256": "@NAMESPACE_KEEPER_SHA256@"},
  "systemctl": {"path": "@SYSTEMCTL_PATH@", "sha256": "@SYSTEMCTL_SHA256@"},
  "nsenter": {"path": "@NSENTER_PATH@", "sha256": "@NSENTER_SHA256@"},
  "ip": {"path": "@IP_PATH@", "sha256": "@IP_SHA256@"},
  "namespace_keeper_unit": {"path": "/etc/systemd/system/urnetwork-private-engine-network-namespace.service", "sha256": "@NAMESPACE_KEEPER_UNIT_SHA256@"},
  "engine_unit": {"path": "/etc/systemd/system/urnetwork-private-engine.service", "sha256": "@ENGINE_UNIT_SHA256@"},
  "containerd_unit": {"path": "/etc/systemd/system/urnetwork-private-containerd.service", "sha256": "@CONTAINERD_UNIT_SHA256@"},
  "network_unit": {"path": "/etc/systemd/system/urnetwork-private-engine-network.service", "sha256": "@NETWORK_UNIT_SHA256@"}
}
