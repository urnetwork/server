replace github.com/pion/sctp => ../../connect/sctp

// Dependency replacements are not inherited from SN; share its corrected
// native RPC transport and tracked upstream provenance in server binaries.
replace github.com/centrifuge/go-substrate-rpc-client/v4 => ../../sn/v2026/third_party/go-substrate-rpc-client

// Share the fork's source with local builds and frozen PERF arms. The source
// lock (local/source-graph/lock.yml) pins this sibling's full revision; the
// release builder converts it to an immutable pin.
replace gvisor.dev/gvisor => github.com/urnetwork/gvisor v0.0.0-20261128001654-9666f1a857f1

// The slow write timer arms a new timer per write instead of resetting the last
// one while it is still in the runtime's timer heap (third_party/pgx/URNETWORK.md).
replace github.com/jackc/pgx/v5 => ./third_party/pgx

// The pool can skip its per-checkout socket check for a connection put back
// within a window, SkipConnCheckWithin, which the pools with command retries
// set (third_party/go-redis/URNETWORK.md; LBALTOPT2 R19).
replace github.com/redis/go-redis/v9 => ./third_party/go-redis

// UConn.Write releases its interlock with Close after its compare-and-swap
// loop, so a write allocates no defer record (third_party/utls/URNETWORK.md;
// CPUOPT7 P3).
replace github.com/refraction-networking/utls => ./third_party/utls
