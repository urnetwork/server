   "fieldConfig": {
    "defaults": {
     "unit": "locale",
     "decimals": 0,
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#8b7be6"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "orientation": "auto",
    "colorMode": "value",
    "graphMode": "area",
    "justifyMode": "center",
    "textMode": "value",
    "wideLayout": true
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "warp-mimir"
     },
     "expr": "max(urnetwork_stats_online_extenders{env=\"$env\"})",
     "refId": "A",
     "legendFormat": "online extenders"
    }
   ],
   "description": "Active extenders with at least one active address \u2014 the population the drip rotates through and the directory publishes. Series are per process and keyed by instance, so this aggregates across the fleet rather than selecting a bare series: during a redeploy the draining and starting processes both push."
  },
