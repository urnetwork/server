{
 "uid": "urnetwork-extenders",
 "title": "urnetwork / extenders",
 "tags": [
  "urnetwork",
  "extenders"
 ],
 "description": "The extender network: population and reachability, what is published in dns, the gossip release queue, and which extenders carry the contract load. Fed by the stats collector (controller/stats_collector.go) and the dns publish tick (taskworker/work/extender_dns_metrics.go).",
 "editable": false,
 "graphTooltip": 1,
 "schemaVersion": 39,
 "refresh": "5m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "timezone": "",
 "templating": {
  "list": [
   {
    "name": "env",
    "label": "env",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "warp-mimir"
    },
    "query": "label_values(urnetwork_stats_online_extenders, env)",
    "refresh": 2,
    "sort": 1
   }
  ]
 },
 "panels": [
