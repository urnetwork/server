{
  "uid": "urnetwork-proxy",
  "title": "urnetwork / proxy",
  "description": "Authenticated Proxy service deep dive. HTTP and SOCKS traffic is measured at the client-facing relay boundary; WireGuard traffic is measured at the provider-device boundary. Device, peer, session, and cache values are aggregate capacity signals and never carry customer identity. Library event totals and several WireGuard gauges are cumulative for one process generation, so rate panels tolerate restarts. Missing or stale telemetry remains no-data.",
  "tags": [
    "urnetwork"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_proxy_ready, env)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "block",
        "label": "block",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_proxy_ready{env=\"$env\"}, block)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_proxy_ready{env=\"$env\",block=~\"$block\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "ready instances",
      "description": "Instances whose initial peer synchronization completed and which are not draining.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_ready{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "drain connections remaining",
      "description": "HTTP and SOCKS connections remaining in the active bounded drain. An absent series is not a completed drain.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_drain_active_remaining{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP / SOCKS admissions / s",
      "description": "Successful dials and bounded authentication or dial failures. WireGuard has a separate packet admission view.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "active relay work",
      "description": "Successfully dialed upstream sessions plus current in-flight ingress work. These overlap and must not be treated as distinct users.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "upstream sessions",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "ingress work",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 29,
      "type": "stat",
      "title": "WireGuard sessions",
      "description": "Peers whose newest completed handshake is inside the three minute session window, beside every peer registered on the devices. WireGuard has no session teardown: a client with traffic re-handshakes every two minutes and a silent one lets its keys expire at three, so in-session is the honest count of clients actually using the tunnel right now, and the gap to registered peers is clients configured but idle.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_wg_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "in session",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_wg_peers{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "registered peers",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 30,
      "type": "stat",
      "title": "SOCKS sessions",
      "description": "Successfully dialed SOCKS upstream sessions not yet closed, beside the SOCKS ingress work in flight (connections, tunnels and UDP associations as the library reports them). The two overlap and must not be added.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"})",
          "legendFormat": "dialed sessions",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"})",
          "legendFormat": "ingress work",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 31,
      "type": "stat",
      "title": "proxy devices",
      "description": "Embedded provider devices installed on the fleet (live), those with client activity inside the activity window (active), and those pre-warmed at startup from the recent-activity set. Live minus active is idle capacity waiting on its idle timeout; a replacement instance shows pre-warmed rising before active does.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_devices_live{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "live",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_devices_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "active",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "sum(urnetwork_proxy_prewarmed_devices{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "prewarmed",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 32,
      "type": "stat",
      "title": "new sessions / s",
      "description": "Sessions begun per second: WireGuard by a peer's first handshake after having none inside the window, SOCKS by an admitted upstream dial. Reset-aware rates over the selected interval.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_proxy_wg_sessions_started_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "WireGuard",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\",outcome=\"admitted\"}[$__rate_interval]))",
          "legendFormat": "SOCKS",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "WireGuard sessions and peers",
      "description": "Peers in session against the registered peer table, with sessions started and ended per second. A session ends when a whole window passes with no new handshake or the peer is removed from the device, so an ended rate that tracks the started rate is churn, and a started rate with a flat in-session count is clients that connect and go quiet at once.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_wg_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "in session"
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_wg_peers{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "registered peers"
        },
        {
          "refId": "C",
          "expr": "sum(rate(urnetwork_proxy_wg_sessions_started_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "started / s"
        },
        {
          "refId": "D",
          "expr": "sum(rate(urnetwork_proxy_wg_sessions_ended_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "ended / s"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "SOCKS sessions",
      "description": "SOCKS upstream sessions open and ingress work in flight, with sessions opened per second and closed per second by terminal outcome. Closes dominated by read or write errors point at the upstream side of the relay, not at SOCKS clients.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"})",
          "legendFormat": "dialed sessions"
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"})",
          "legendFormat": "ingress work"
        },
        {
          "refId": "C",
          "expr": "sum(rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\",outcome=\"admitted\"}[$__rate_interval]))",
          "legendFormat": "opened / s"
        },
        {
          "refId": "D",
          "expr": "sum by (outcome) (rate(urnetwork_proxy_sessions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"}[$__rate_interval]))",
          "legendFormat": "closed / s {{outcome}}"
        }
      ]
    },
    {
      "id": 35,
      "type": "timeseries",
      "title": "mean WireGuard and SOCKS session duration",
      "description": "Mean duration of the sessions that ended in each interval, as sum over count of the duration summaries (no histogram buckets, so no cardinality cost). A WireGuard duration is first completed handshake to last, which understates a session by up to one rekey interval; a SOCKS duration is dial to close. Nothing renders in an interval with no ended session.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_proxy_wg_session_duration_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum(rate(urnetwork_proxy_wg_session_duration_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "WireGuard"
        },
        {
          "refId": "B",
          "expr": "sum(rate(urnetwork_proxy_session_duration_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"}[$__rate_interval])) / sum(rate(urnetwork_proxy_session_duration_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\",protocol=\"socks\"}[$__rate_interval]))",
          "legendFormat": "SOCKS"
        }
      ]
    },
    {
      "id": 36,
      "type": "timeseries",
      "title": "proxy devices",
      "description": "Installed embedded devices over time: live, active inside the activity window, and pre-warmed. Active is refreshed on the activity flush cadence, so it lags a burst of new clients by up to a minute. Missing or stale telemetry remains no-data rather than zero.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_proxy_devices_live{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "live"
        },
        {
          "refId": "B",
          "expr": "sum(urnetwork_proxy_devices_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "active"
        },
        {
          "refId": "C",
          "expr": "sum(urnetwork_proxy_prewarmed_devices{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "prewarmed"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "admissions by protocol and outcome",
      "description": "Finite outcomes are admitted, unauthorized, and dial_failed; no address or credential is retained.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, outcome) (rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} {{outcome}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "session closes by outcome",
      "description": "Completed upstream sessions and bounded read/write terminal failures by HTTP or SOCKS.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, outcome) (rate(urnetwork_proxy_sessions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} {{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "client-boundary relay bytes / s",
      "description": "HTTP/SOCKS body and tunnel bytes on the upstream relay connection: client_to_destination is Write; destination_to_client is Read.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, direction) (rate(urnetwork_proxy_session_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} {{direction}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "mean session duration",
      "description": "Rate-derived mean completed HTTP/SOCKS upstream-session duration by finite protocol.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(urnetwork_proxy_session_duration_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum by (protocol) (rate(urnetwork_proxy_session_duration_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "mean {{protocol}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "fresh one-minute maximum session duration",
      "description": "Exact process maxima only while their paired close timestamp is within 120 seconds; no closes or stale publication remains no-data.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (protocol) (urnetwork_proxy_session_interval_max_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} and on (env, service, block, host, instance, protocol) (urnetwork_proxy_session_interval_max_timestamp_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} > time() - 120 and urnetwork_proxy_session_interval_max_timestamp_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} < time() + 30))",
          "legendFormat": "{{protocol}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "bounded HTTP / SOCKS library events / s",
      "description": "Fixed library reasons expose dial, framing, relay, body-limit, upgrade, and UDP-association behavior without request or destination labels.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol, reason) (rate(urnetwork_proxy_ingress_events_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{protocol}} {{reason}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "HTTP / SOCKS ingress work",
      "description": "Current connections, requests, tunnels, or UDP associations reported by each ingress implementation.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "{{protocol}}"
        },
        {
          "refId": "B",
          "expr": "sum by (protocol) (urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})",
          "legendFormat": "dialed {{protocol}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "WireGuard packets / s by direction and outcome",
      "description": "Inner packets offered at the aggregate provider-device boundary; delivered and dropped stay distinct.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, outcome) (rate(urnetwork_proxy_wireguard_packets_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} {{outcome}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "WireGuard bytes / s by direction and outcome",
      "description": "Inner-packet bytes at the provider-device boundary; transport framing is excluded.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, outcome) (rate(urnetwork_proxy_wireguard_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} {{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "WireGuard queue drops and receiver failures / s",
      "description": "Process-generation cumulative gauges sampled from the device. Rates distinguish peer-queue drops, decryption-queue drops, and unexpected receive-routine exits.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_proxy_wg_inbound_peer_queue_drop_packets{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "peer queue drops"
        },
        {
          "refId": "B",
