{
  "uid": "urnetwork-public-traffic",
  "title": "urnetwork / network stats",
  "description": "Public network measurements. Weekly block values reset at 00:00 UTC Sunday; the previous-block values are the last finished block. A missing optional measurement is shown as no data rather than as zero.",
  "tags": [
    "urnetwork",
    "public"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "data transferred in selected range",
      "description": "Acknowledged connect-path transfer bytes in the dashboard time range. The instant query evaluates the range once; summing overlapping fixed windows would overcount.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decbytes",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(urnetwork_connect_transfer_bytes{instance!=\"\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "connected devices now",
      "description": "Distinct resident client devices across the connect fleet. A device can have more than one transport connection, so this intentionally uses resident_clients rather than connected_clients.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(urnetwork_connect_resident_clients{instance!=\"\"})",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "live exchange throughput",
      "description": "Current completed exchange data-frame write rate across the fleet, including the fixed 4-byte exchange frame header and excluding pings and handshakes. Sent is used alone because fleet sent and received are two observations of the same inter-server traffic.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_connect_exchange_io_bytes_total{direction=\"sent\",kind=\"data\",instance!=\"\"}[$__rate_interval])) * 8",
          "legendFormat": "throughput"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "connected devices",
      "description": "Distinct resident client devices, summed across the connect fleet.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
