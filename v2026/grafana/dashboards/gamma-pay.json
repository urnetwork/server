{
  "uid": "urnetwork-gamma-pay",
  "title": "urnetwork / gamma payments",
  "description": "Pay with Gamma (mmm/BTCPAY.md §18): the taskworker's biller and watcher. Since runtime 493 each charge is a fee-free spend_gamma at our service, signed by the SN25 deposit's own hotkey (its key derived from the deposit seed); a purchase is credited only on the finalized GammaSpent our own extrinsic emitted.",
  "tags": [
    "urnetwork",
    "payments"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_gamma_pay_readiness, env)",
        "definition": "label_values(urnetwork_gamma_pay_readiness, env)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "biller readiness",
      "description": "The biller's readiness: 1 for the current reason. Anything but ready pauses new charges (not_configured until gamma.yml with the deposit seed is on the taskworker; service_not_published while SN25 lists no service for its owner hotkey; runtime_unsupported pauses on an unreviewed runtime; batch_in_review waits for an operator).",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (reason) (urnetwork_gamma_pay_readiness{env=\"$env\",service=\"taskworker\",instance!=\"\"}) == 1",
          "legendFormat": "{{reason}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "TAO/USD oracle age",
      "description": "Blocks since the chain's TAO/USD oracle last fed. Every mint fails past 300 (TaoUsdPriceUnavailable); spending existing deposits does not need it.",
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(urnetwork_gamma_pay_price_age_blocks{env=\"$env\",service=\"taskworker\",instance!=\"\"})",
          "legendFormat": "blocks",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "watcher lag",
      "description": "Finalized blocks the watcher has not read yet. Selling pauses (watcher_behind) past 100.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(urnetwork_gamma_pay_scan_lag_blocks{env=\"$env\",service=\"taskworker\",instance!=\"\"})",
          "legendFormat": "lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "alarms / s by kind",
      "description": "Watcher alarms: unknown_reference (a GammaSpent by one of our deposit hotkeys that is none of our spends, at our service or another: the earliest sign of a leaked deposit seed), spend_mismatch, unexpected_nonce, runtime_unsupported, undecodable_block, service_changed, and stray_tao (plain TAO sent to a deposit hotkey, recoverable). Any but stray_tao needs the owner.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(urnetwork_gamma_pay_alarms_total{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "intents made / s by purpose",
      "description": "Gamma intents: purchase (POST /pay/gamma/intent, on the api) and the biller's automatic renew, topup and seat.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose) (rate(urnetwork_gamma_pay_intents_created_total{env=\"$env\",service=~\"api|alt|taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "charges resolved / s",
      "description": "Charges resolved: spent (our finalized GammaSpent), or skipped before anything was sent, with the reason (insufficient_gamma, daily_cap_exceeded, daily_cap_too_low, no_deposit, refused); and foreign, a spend at our service from a hotkey we never assigned (no charge of ours; it stays in that hotkey's GammaSpent total).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state, reason) (rate(urnetwork_gamma_pay_charges_resolved_total{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{state}} {{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "credits / s",
      "description": "Intents credited on our finalized GammaSpent, by purpose and delivery.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (purpose, delivery) (rate(urnetwork_gamma_pay_credits_total{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{purpose}} {{delivery}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "spends submitted and their fees",
      "description": "Spends signed (each as its deposit's hotkey) and submitted, at most one live at a time; since runtime 493 a spend pays no fee.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_gamma_pay_batches_submitted_total{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "batches / s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(urnetwork_gamma_pay_batch_fee_rao_sum{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval])) / sum(rate(urnetwork_gamma_pay_batch_fee_rao_count{env=\"$env\",service=\"taskworker\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "mean fee (rao)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    }
  ]
}
