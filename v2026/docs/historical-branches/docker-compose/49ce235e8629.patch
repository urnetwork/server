diff --git a/docker-compose.yml b/docker-compose.yml
new file mode 100644
index 00000000..26a5048b
--- /dev/null
+++ b/docker-compose.yml
@@ -0,0 +1,119 @@
+services:
+  api:
+    environment:
+      - WARP_VERSION=0.0.0
+      - WARP_ENV=local
+      - WARP_VAULT_HOME=/vault
+      - BRINGYOUR_POSTGRES_HOSTNAME=postgres
+    build:
+      context: ../
+      dockerfile: bringyour/api/Dockerfile.compose
+    develop:
+      watch:
+        - path: api
+          action: rebuild
+    ports:
+      - "8080:80"
+    volumes:
+      - ../vault:/vault
+    depends_on:
+      db-migrate:
+        condition: service_completed_successfully
+      redis:
+        condition: service_started
+
+  connect:
+    environment:
+      - WARP_VERSION=0.0.0
+      - WARP_ENV=local
+      - WARP_SERVICE=local
+      - WARP_BLOCK=local
+      - WARP_VAULT_HOME=/vault
