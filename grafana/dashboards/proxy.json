{
  "uid": "urnetwork-proxy",
  "title": "urnetwork / proxy",
  "description": "Authenticated Proxy service deep dive. HTTP and SOCKS traffic is measured at the client-facing relay boundary; WireGuard traffic is measured at the provider-device boundary. Device, peer, session, and cache values are aggregate capacity signals and never carry customer identity. Library event totals and several WireGuard gauges are cumulative for one process generation, so rate panels tolerate restarts. Missing or stale telemetry remains no-data.",
  "tags": ["urnetwork"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {"list": [
    {"name": "env", "label": "env", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_proxy_ready, env)", "refresh": 2, "sort": 1},
    {"name": "block", "label": "block", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_proxy_ready{env=\"$env\"}, block)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true},
    {"name": "host", "label": "host", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_proxy_ready{env=\"$env\",block=~\"$block\"}, host)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "ready instances", "description": "Instances whose initial peer synchronization completed and which are not draining.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_ready{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 2, "type": "stat", "title": "drain connections remaining", "description": "HTTP and SOCKS connections remaining in the active bounded drain. An absent series is not a completed drain.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_drain_active_remaining{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 3, "type": "stat", "title": "HTTP / SOCKS admissions / s", "description": "Successful dials and bounded authentication or dial failures. WireGuard has a separate packet admission view.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "instant": true, "range": false}]},
    {"id": 4, "type": "stat", "title": "active relay work", "description": "Successfully dialed upstream sessions plus current in-flight ingress work. These overlap and must not be treated as distinct users.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "upstream sessions", "instant": true, "range": false}, {"refId": "B", "expr": "sum(urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "ingress work", "instant": true, "range": false}]},

    {"id": 5, "type": "timeseries", "title": "admissions by protocol and outcome", "description": "Finite outcomes are admitted, unauthorized, and dial_failed; no address or credential is retained.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol, outcome) (rate(urnetwork_proxy_ingress_admissions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{protocol}} {{outcome}}"}]},
    {"id": 6, "type": "timeseries", "title": "session closes by outcome", "description": "Completed upstream sessions and bounded read/write terminal failures by HTTP or SOCKS.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol, outcome) (rate(urnetwork_proxy_sessions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{protocol}} {{outcome}}"}]},
    {"id": 7, "type": "timeseries", "title": "client-boundary relay bytes / s", "description": "HTTP/SOCKS body and tunnel bytes on the upstream relay connection: client_to_destination is Write; destination_to_client is Read.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol, direction) (rate(urnetwork_proxy_session_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{protocol}} {{direction}}"}]},
    {"id": 8, "type": "timeseries", "title": "session duration mean, p95, p99", "description": "Completed HTTP/SOCKS upstream-session duration. Quantiles are estimates from bounded histogram buckets.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol) (rate(urnetwork_proxy_session_duration_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum by (protocol) (rate(urnetwork_proxy_session_duration_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "mean {{protocol}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, protocol) (rate(urnetwork_proxy_session_duration_seconds_bucket{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p95 {{protocol}}"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, protocol) (rate(urnetwork_proxy_session_duration_seconds_bucket{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p99 {{protocol}}"}]},
    {"id": 9, "type": "timeseries", "title": "fresh one-minute maximum session duration", "description": "Exact process maxima only while their paired close timestamp is within 120 seconds; no closes or stale publication remains no-data.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max by (protocol) (urnetwork_proxy_session_interval_max_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} and on (env, service, block, host, instance, protocol) (urnetwork_proxy_session_interval_max_timestamp_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} > time() - 120 and urnetwork_proxy_session_interval_max_timestamp_seconds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"} < time() + 30))", "legendFormat": "{{protocol}}"}]},
    {"id": 10, "type": "timeseries", "title": "bounded HTTP / SOCKS library events / s", "description": "Fixed library reasons expose dial, framing, relay, body-limit, upgrade, and UDP-association behavior without request or destination labels.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol, reason) (rate(urnetwork_proxy_ingress_events_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{protocol}} {{reason}}"}]},

    {"id": 11, "type": "timeseries", "title": "HTTP / SOCKS ingress work", "description": "Current connections, requests, tunnels, or UDP associations reported by each ingress implementation.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (protocol) (urnetwork_proxy_ingress_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{protocol}}"}, {"refId": "B", "expr": "sum by (protocol) (urnetwork_proxy_sessions_active{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "dialed {{protocol}}"}]},
    {"id": 12, "type": "timeseries", "title": "WireGuard packets / s by direction and outcome", "description": "Inner packets offered at the aggregate provider-device boundary; delivered and dropped stay distinct.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (direction, outcome) (rate(urnetwork_proxy_wireguard_packets_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{direction}} {{outcome}}"}]},
    {"id": 13, "type": "timeseries", "title": "WireGuard bytes / s by direction and outcome", "description": "Inner-packet bytes at the provider-device boundary; transport framing is excluded.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (direction, outcome) (rate(urnetwork_proxy_wireguard_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{direction}} {{outcome}}"}]},
    {"id": 14, "type": "timeseries", "title": "WireGuard queue drops and receiver failures / s", "description": "Process-generation cumulative gauges sampled from the device. Rates distinguish peer-queue drops, decryption-queue drops, and unexpected receive-routine exits.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_proxy_wg_inbound_peer_queue_drop_packets{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "peer queue drops"}, {"refId": "B", "expr": "sum(rate(urnetwork_proxy_wg_inbound_decryption_queue_drop_packets{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "decryption queue drops"}, {"refId": "C", "expr": "sum(rate(urnetwork_proxy_wg_receive_routine_failures{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "receiver failures"}]},

    {"id": 15, "type": "timeseries", "title": "aggregate devices, peers, prewarm, and lifecycle", "description": "Fleet capacity and deployment continuity without device or customer labels. lifecycle join must be 1 per serving instance.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_devices_live{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "live devices"}, {"refId": "B", "expr": "sum(urnetwork_proxy_wg_peers{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "WireGuard peers"}, {"refId": "C", "expr": "sum(urnetwork_proxy_prewarmed_devices{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "prewarmed"}, {"refId": "D", "expr": "min(urnetwork_proxy_lifecycle_join_enabled{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "minimum lifecycle join"}]},
    {"id": 16, "type": "timeseries", "title": "device memory target and tracked use", "description": "Aggregate DeviceLocal steady-state target and tracked live use; compare with process RSS for untracked runtime and pool memory.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_device_memory_target_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "target bytes"}, {"refId": "B", "expr": "sum(urnetwork_proxy_device_memory_tracked_used_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "tracked used bytes"}]},
    {"id": 17, "type": "timeseries", "title": "platform transport byte capacity", "description": "Aggregate private carrier byte budget, acquired bytes, and bytes waiting for H1 admission.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_platform_transport_budget_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "budget"}, {"refId": "B", "expr": "sum(urnetwork_proxy_platform_transport_used_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "used"}, {"refId": "C", "expr": "sum(urnetwork_proxy_platform_transports_pending_h1_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "pending H1"}]},
    {"id": 18, "type": "timeseries", "title": "platform transport count capacity", "description": "Aggregate configured private carrier count, acquired carriers, and pending H1 admissions.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_platform_transports_max{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "maximum"}, {"refId": "B", "expr": "sum(urnetwork_proxy_platform_transports_used{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "used"}, {"refId": "C", "expr": "sum(urnetwork_proxy_platform_transports_pending_h1{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "pending H1"}]},

    {"id": 19, "type": "timeseries", "title": "WireGuard return backpressure", "description": "Packets that waited for bounded receive-queue capacity plus mean and p95 wait duration.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_proxy_wireguard_return_backpressure_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "packets/s"}, {"refId": "B", "expr": "sum(rate(urnetwork_proxy_wireguard_return_backpressure_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum(rate(urnetwork_proxy_wireguard_return_backpressure_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "mean seconds"}, {"refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(urnetwork_proxy_wireguard_return_backpressure_seconds_bucket{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p95 seconds"}]},
    {"id": 20, "type": "timeseries", "title": "caller-lock cache occupancy", "description": "Bounded aggregate cache entries and hard capacity; no address or proxy credential is exported.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_proxy_lock_cache_entries{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "entries"}, {"refId": "B", "expr": "sum(urnetwork_proxy_lock_cache_capacity{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "capacity"}]},
    {"id": 21, "type": "timeseries", "title": "caller-lock cache activity / s", "description": "Cache hits, misses, expirations, and hard-bound evictions without caller labels.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 69}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_proxy_lock_cache_hits_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "hits"}, {"refId": "B", "expr": "sum(rate(urnetwork_proxy_lock_cache_misses_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "misses"}, {"refId": "C", "expr": "sum(rate(urnetwork_proxy_lock_cache_expirations_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "expirations"}, {"refId": "D", "expr": "sum(rate(urnetwork_proxy_lock_cache_evictions_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "evictions"}]},
    {"id": 22, "type": "timeseries", "title": "control and device-RPC HTTP outcomes", "description": "Bounded configured control routes include status, warmup, and the hosted device RPC lifecycle. Hijacked sessions retain route outcome and duration without path labels.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 69}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, status, outcome) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}} {{status}} {{outcome}}"}]},

    {"id": 23, "type": "timeseries", "title": "control and device-RPC bytes and inflight", "description": "HTTP body bytes exclude bytes sent after a WebSocket hijack; in-flight route duration remains the RPC session control. Absence is not interpreted as zero traffic.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 77}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "request bytes/s {{route}}"}, {"refId": "B", "expr": "sum by (route) (rate(urnetwork_http_response_bytes_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "response bytes/s {{route}}"}, {"refId": "C", "expr": "sum by (route) (urnetwork_http_requests_inflight{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "inflight {{route}}"}]},
    {"id": 24, "type": "timeseries", "title": "control and device-RPC duration", "description": "Mean, p95, and p99 configured-route duration. A hosted WebSocket's duration covers its served session after hijack.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 77}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_duration_seconds_sum{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum by (route) (rate(urnetwork_http_request_duration_seconds_count{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "mean {{route}}"}, {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(urnetwork_http_request_duration_seconds_bucket{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p95 {{route}}"}, {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le, route) (rate(urnetwork_http_request_duration_seconds_bucket{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p99 {{route}}"}]},
    {"id": 25, "type": "timeseries", "title": "control-plane database and Redis pressure", "description": "Initialized PostgreSQL pools and Redis connections used by proxy synchronization, authorization, warmup, and device control.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 85}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (pool, state) (urnetwork_pg_pool_connections{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "PG {{pool}} {{state}}"}, {"refId": "B", "expr": "sum(urnetwork_redis_pool_total_conns{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "Redis total"}, {"refId": "C", "expr": "sum(rate(urnetwork_redis_pool_timeouts_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "Redis timeouts/s"}]},
    {"id": 26, "type": "timeseries", "title": "process CPU, memory, goroutines, and file descriptors", "description": "Proxy process saturation controls by selected deployment block and host.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 85}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(process_cpu_seconds_total{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "CPU cores"}, {"refId": "B", "expr": "sum(process_resident_memory_bytes{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "RSS bytes"}, {"refId": "C", "expr": "sum(go_goroutines{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "goroutines"}, {"refId": "D", "expr": "sum(process_open_fds{env=\"$env\",service=\"proxy\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "open fds"}]}
  ]
}
