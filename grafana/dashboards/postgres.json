{
  "uid": "urnetwork-postgres",
  "title": "urnetwork / postgres",
  "description": "PostgreSQL health and workload: availability, connection pressure and idle transactions, transaction/row rates, cache efficiency, locks, deadlocks, temporary I/O, database growth, and host pressure.",
  "tags": ["urnetwork", "postgres", "database", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(pg_up{job=\"postgres\"}, env)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(pg_up{env=\"$env\",job=\"postgres\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "database",
        "label": "database",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(pg_stat_database_numbackends{env=\"$env\",host=~\"$host\",job=\"postgres\"}, datname)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 16,
      "title": "backlog: PgBouncer queue, idle transactions and service pool waits",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "id": 17,
      "title": "PgBouncer clients waiting (5m avg)",
      "description": "Clients queued for a PgBouncer server connection, summed over every pool of every instance in the env and averaged over five minutes (pgbouncer_pool_clients_waiting, SHOW POOLS cl_waiting read every 15 s). Normal is 0. Orange at 100 (warn) and red at 1,000 (page), the SIGNALS.md section 26 thresholds. On 2026-10-26 it held thousands for hours while every server connection was busy and PostgreSQL sat idle in transaction, waiting on CPU-starved clients.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "decimals": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 100}, {"color": "red", "value": 1000}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "sum(avg_over_time(pgbouncer_pool_clients_waiting{env=\"$env\",job=\"pgbouncer\"}[5m]))", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 18,
      "title": "oldest PgBouncer queue wait",
      "description": "How long the oldest queued client has waited in the worst pool, as the highest one-minute maximum of pgbouncer_pool_maxwait_seconds. Red at 3 s, where the warp alert PgBouncerPoolQueueWaitHigh fires; query_wait_timeout disconnects clients that wait 4 s.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 3}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max(max_over_time(pgbouncer_pool_maxwait_seconds{env=\"$env\",job=\"pgbouncer\"}[1m]))", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 19,
      "title": "highest service DB acquire wait",
      "description": "Mean time a service waited to check out a PostgreSQL connection from its default pool over five minutes: acquire wait seconds over successful acquires, summed over the service's processes, highest service shown. Red at 100 ms (SIGNALS.md section 26). It climbs when PgBouncer queues or a pool is fully checked out; acquires abandoned before a connection came are not in the mean.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "s", "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max(sum by (service) (rate(urnetwork_pg_pool_acquire_duration_seconds_total{env=\"$env\",pool=\"default\",instance!=\"\"}[5m])) / (sum by (service) (rate(urnetwork_pg_pool_acquires_total{env=\"$env\",pool=\"default\",outcome=\"acquired\",instance!=\"\"}[5m])) > 0))", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 20,
      "title": "busiest service DB pool in use",
      "description": "Checked-out connections over the configured maximum of each service's default PostgreSQL pool, summed over the service's processes; the busiest service shown. At 100% every further acquire waits. No SIGNALS.md section 26 threshold; read it with the acquire wait.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 0, "min": 0, "max": 1, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max(sum by (service) (urnetwork_pg_pool_connections{env=\"$env\",pool=\"default\",state=\"acquired\",instance!=\"\"}) / (sum by (service) (urnetwork_pg_pool_connections{env=\"$env\",pool=\"default\",state=\"maximum\",instance!=\"\"}) > 0))", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 21,
      "title": "PgBouncer clients waiting, all pools",
      "description": "Clients queued for a server connection across all pools: the five-minute average, the SIGNALS.md section 26 signal with lines at 100 (warn) and 1,000 (page), and the latest 15 s reading. A queue that persists while the server connections stay at their cap is the 2026-10-26 backlog.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 100}, {"color": "red", "value": 1000}]}, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "line"}}}, "overrides": [{"matcher": {"id": "byName", "options": "5m average"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}, {"id": "custom.lineWidth", "value": 3}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum(avg_over_time(pgbouncer_pool_clients_waiting{env=\"$env\",job=\"pgbouncer\"}[5m]))", "legendFormat": "5m average", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "sum(pgbouncer_pool_clients_waiting{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "latest", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 22,
      "title": "PgBouncer clients waiting per pool",
      "description": "Queued clients in the busiest and in the median of the PgBouncer pools. A busiest pool far above the median points at uneven client placement, such as the front proxy's accept imbalance on 2026-10-26; both rising together is saturation of every pool.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 5},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "max(pgbouncer_pool_clients_waiting{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "busiest pool", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "quantile(0.5, pgbouncer_pool_clients_waiting{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "median pool", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 23,
      "title": "PgBouncer queue wait of the oldest client",
      "description": "How long the oldest queued client has waited (pgbouncer_pool_maxwait_seconds), in the worst pool and in the median pool. The line at 3 s is where PgBouncerPoolQueueWaitHigh fires; query_wait_timeout disconnects clients at 4 s.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 5},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 3}]}, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "line"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "max(pgbouncer_pool_maxwait_seconds{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "worst pool", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "quantile(0.5, pgbouncer_pool_maxwait_seconds{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "median pool", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 24,
      "title": "PgBouncer server connections",
      "description": "Server connections that can run a query (sv_active + sv_idle + sv_used + sv_tested), summed over the pools, and server connections logging in. The exporter neither splits active from idle nor exports the pool size: compare with 32 instances times default_pool_size. A total held at that cap while clients queue means every server connection is busy.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum(pgbouncer_pool_servers{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "servers", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "sum(pgbouncer_pool_server_logins{env=\"$env\",job=\"pgbouncer\"})", "legendFormat": "logging in", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 25,
      "title": "client backends: active vs idle in transaction",
      "description": "PostgreSQL client backends by state. Idle in transaction is a session holding its transaction, and its PgBouncer server connection, open while PostgreSQL waits for the client's next statement. Many more idle in transaction than active means the clients, not PostgreSQL, are slow: on 2026-10-26, 532 of 571 busy backends were idle in transaction while the services edges were CPU-saturated.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 13},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": [{"matcher": {"id": "byName", "options": "idle in transaction"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]}]},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (state) (pg_stat_activity_count{env=\"$env\",host=~\"$host\",datname=~\"$database\",job=\"postgres\",backend_type=\"client backend\",state=~\"active|idle in transaction.*\"})", "legendFormat": "{{state}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 26,
      "title": "oldest open transaction",
      "description": "Age of the oldest transaction idle in transaction, and of the oldest active client transaction (pg_stat_activity_max_tx_duration). A long idle transaction holds its locks and pins xmin; the idle-in-transaction timeout ends it.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 13},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "max(pg_stat_activity_max_tx_duration{env=\"$env\",host=~\"$host\",datname=~\"$database\",job=\"postgres\",state=~\"idle in transaction.*\"})", "legendFormat": "idle in transaction", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "max(pg_stat_activity_max_tx_duration{env=\"$env\",host=~\"$host\",datname=~\"$database\",job=\"postgres\",backend_type=\"client backend\",state=\"active\"})", "legendFormat": "active", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 27,
      "title": "service DB pool mean acquire wait",
      "description": "Mean wait per successful connection checkout from each service's default PostgreSQL pool: acquire seconds over acquires, summed over the service's processes. The line is the SIGNALS.md section 26 threshold of 100 ms. Abandoned acquires are not in the mean.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.1}]}, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}, "thresholdsStyle": {"mode": "line"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (rate(urnetwork_pg_pool_acquire_duration_seconds_total{env=\"$env\",pool=\"default\",instance!=\"\"}[$__rate_interval])) / (sum by (service) (rate(urnetwork_pg_pool_acquires_total{env=\"$env\",pool=\"default\",outcome=\"acquired\",instance!=\"\"}[$__rate_interval])) > 0)", "legendFormat": "{{service}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 28,
      "title": "service DB pool in use",
      "description": "Checked-out connections over the configured maximum of each service's default PostgreSQL pool, summed over the service's processes.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 21},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (urnetwork_pg_pool_connections{env=\"$env\",pool=\"default\",state=\"acquired\",instance!=\"\"}) / (sum by (service) (urnetwork_pg_pool_connections{env=\"$env\",pool=\"default\",state=\"maximum\",instance!=\"\"}) > 0)", "legendFormat": "{{service}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 29,
      "title": "service DB acquires abandoned / s",
      "description": "Connection checkouts from each service's default PostgreSQL pool canceled before a connection was free, usually by the caller's deadline. They rise with the queue and are missing from the mean wait.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (service) (rate(urnetwork_pg_pool_acquires_total{env=\"$env\",pool=\"default\",outcome=\"canceled\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{service}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 30,
      "title": "database health",
      "type": "row",
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 29},
      "panels": []
    },
    {
      "id": 1,
      "title": "PostgreSQL up",
      "description": "Exporter connection to PostgreSQL. Zero means the database or local socket query is unavailable.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 30},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "options": {"0": {"text": "down", "color": "red"}, "1": {"text": "up", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "min(pg_up{env=\"$env\",host=~\"$host\",job=\"postgres\"})", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 2,
      "title": "connection utilization",
      "description": "All backends divided by max_connections. Poolers should keep this well below saturation.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 30},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "100 * sum(pg_stat_activity_count{env=\"$env\",host=~\"$host\",job=\"postgres\"}) / sum(pg_settings_max_connections{env=\"$env\",host=~\"$host\",job=\"postgres\"})", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 3,
      "title": "idle in transaction",
      "description": "Sessions holding a transaction open while idle. Sustained values pin xmin and consume connections.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 30},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 10}, {"color": "red", "value": 100}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "sum(pg_stat_activity_count{env=\"$env\",host=~\"$host\",datname=~\"$database\",job=\"postgres\",state=~\"idle in transaction.*\"}) or on() vector(0)", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 4,
