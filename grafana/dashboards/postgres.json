      "panels": []
    },
    {
      "id": 34,
      "title": "churn-table vacuums finished per hour by table",
      "description": "The taskworker's hot vacuum (db_maintenance_hot_vacuum.go) runs an explicit VACUUM (SKIP_LOCKED) over each churn table every few minutes, because six autovacuum workers serving the large tables leave these small, constantly rewritten tables waiting for hours. Vacuums whose VERBOSE summary reported them finished, per table, counted over the trailing hour: one per run that reached the table. A table that falls away here while the others hold is not being vacuumed; the panel beside it says why. The series come from the taskworker processes, so the host and database filters do not apply.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 91},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"], "sortBy": "Max", "sortDesc": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (table) (increase(urnetwork_db_hot_vacuum_attempts_total{env=\"$env\",service=\"taskworker\",outcome=\"vacuumed\",instance!=\"\"}[1h]))", "legendFormat": "{{table}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 35,
      "title": "churn-table vacuums not finished, and stale tables, per hour",
