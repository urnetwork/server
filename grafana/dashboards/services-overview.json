{
    "uid": "urnetwork-services",
    "title": "urnetwork / services overview",
    "tags": ["urnetwork"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "30s",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "env",
                "label": "env",
                "type": "query",
                "datasource": {"type": "prometheus", "uid": "warp-mimir"},
                "query": "label_values(go_goroutines, env)",
                "refresh": 2,
                "sort": 1
            },
            {
                "name": "service",
                "label": "service",
                "type": "query",
                "datasource": {"type": "prometheus", "uid": "warp-mimir"},
                "query": "label_values(go_goroutines{env=\"$env\"}, service)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true
            },
            {
                "name": "block",
                "label": "block",
                "type": "query",
                "datasource": {"type": "prometheus", "uid": "warp-mimir"},
                "query": "label_values(go_goroutines{env=\"$env\",service=~\"$service\"}, block)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true
            },
            {
                "name": "host",
                "label": "host",
                "type": "query",
                "datasource": {"type": "prometheus", "uid": "warp-mimir"},
                "query": "label_values(go_goroutines{env=\"$env\",service=~\"$service\"}, host)",
                "refresh": 2,
                "sort": 1,
                "multi": true,
                "includeAll": true
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "cpu (cores)",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, block, host) (rate(process_cpu_seconds_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "{{service}} {{block}} {{host}}"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "memory (rss)",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, block, host) (process_resident_memory_bytes{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"})",
                    "legendFormat": "{{service}} {{block}} {{host}}"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "goroutines",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, block, host) (go_goroutines{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"})",
                    "legendFormat": "{{service}} {{block}} {{host}}"
                }
            ]
        },
        {
            "id": 4,
            "type": "timeseries",
            "title": "open file descriptors",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, block, host) (process_open_fds{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"})",
                    "legendFormat": "{{service}} {{block}} {{host}}"
                }
            ]
        },
        {
            "id": 5,
            "type": "table",
            "title": "running versions",
            "gridPos": {"h": 7, "w": 24, "x": 0, "y": 16},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {}, "overrides": []},
            "options": {},
            "transformations": [
                {
                    "id": "labelsToFields",
                    "options": {}
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true,
                            "Value": true,
                            "__name__": true,
                            "job": true,
                            "instance": true
                        }
                    }
                }
            ],
            "targets": [
                {
                    "refId": "A",
                    "expr": "urnetwork_build_info{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}",
                    "format": "table",
                    "instant": true
                }
            ]
        },
        {
            "id": 6,
            "type": "table",
            "title": "running source revisions",
            "description": "Full Go VCS revision, modified state, and immutable image digest reported by each selected service process. Use this beside the release version table to distinguish two images or dirty builds carrying the same version label.",
            "gridPos": {"h": 7, "w": 24, "x": 0, "y": 23},
            "datasource": {"type": "prometheus", "uid": "warp-mimir"},
            "fieldConfig": {"defaults": {}, "overrides": []},
            "options": {},
            "transformations": [
                {
                    "id": "labelsToFields",
                    "options": {}
                },
                {
                    "id": "organize",
                    "options": {
                        "excludeByName": {
                            "Time": true,
                            "Value": true,
                            "__name__": true,
                            "job": true,
                            "instance": true
                        }
                    }
                }
            ],
            "targets": [
                {
                    "refId": "A",
                    "expr": "urnetwork_source_info{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}",
                    "format": "table",
                    "instant": true
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "PostgreSQL constructor startup phases",
            "description": "Constructors inside the initial Ping or failed-startup cleanup now, completed phases per second by outcome (cleanup ok requires an observed CleanupDone), and completed phase seconds per second for each pool generation.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 30
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, pool, phase) (urnetwork_pg_pool_startup_phases_active{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"})",
                    "legendFormat": "active {{service}} {{pool}} {{phase}}"
                },
                {
                    "refId": "B",
                    "expr": "sum by (service, pool, phase, outcome) (rate(urnetwork_pg_pool_startup_phases_completed_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "completed / s {{service}} {{pool}} {{phase}} {{outcome}}"
                },
                {
                    "refId": "C",
                    "expr": "sum by (service, pool, phase) (rate(urnetwork_pg_pool_startup_phase_duration_seconds_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "seconds / s {{service}} {{pool}} {{phase}}"
                }
            ]
        },
        {
            "id": 8,
            "type": "timeseries",
            "title": "PostgreSQL wrapper ownership",
            "description": "Observed Db and Tx wrapper ownership, release and pending disposal by state (excludes raw leases and pool-internal disposal), and cleanup observations per second dropped because a generation's bounded registry was full.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 30
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, pool, state) (urnetwork_pg_pool_wrapper_connections{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"})",
                    "legendFormat": "{{service}} {{pool}} {{state}}"
                },
                {
                    "refId": "B",
                    "expr": "sum by (service, pool) (rate(urnetwork_pg_pool_wrapper_cleanup_tracking_dropped_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "tracking dropped / s {{service}} {{pool}}"
                }
            ]
        },
        {
            "id": 9,
            "type": "timeseries",
            "title": "aborted transactions, rerun decisions and statement stops / s",
            "description": "Transactions a callback went on with after a failed statement, by the statement's failure class; decisions about rerunning a callback after a rerunnable failure; and transaction statements in flight when their caller stopped, by whether they completed on the connection (which keeps the session) or the stop bound interrupted them.",
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 38
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, class) (rate(urnetwork_db_aborted_transactions_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "aborted {{service}} {{class}}"
                },
                {
                    "refId": "B",
                    "expr": "sum by (service, class, decision) (rate(urnetwork_db_rerun_decisions_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "rerun {{service}} {{class}} {{decision}}"
                },
                {
                    "refId": "C",
                    "expr": "sum by (service, outcome) (rate(urnetwork_db_transaction_statement_stops_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "statement stop {{service}} {{outcome}}"
                }
            ]
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "contention refusals recovered / s",
            "description": "Contention refusals, such as a balance owner another writer holds, that HandleError recovered as expected backpressure, without an unexpected-error report. The refused work is left to the holder or a later attempt; a rate that keeps rising means more and more work meets held owners.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 46
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service) (rate(urnetwork_contention_refusals_recovered_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "{{service}}"
                }
            ]
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "ARIN database age by process",
            "description": "Time since the build of the latest ARIN database each process opened (arindbctl/ARINDB.md, Dual-database canary). A process that has not opened its pair yet reports 0 and is left out; Taskworker opens it at its first score publication and performs no lookups. A pair opens once per process and never follows a later config selection, so processes at different ages are a fleet not yet restarted onto a new database.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 46
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "time() - max by (service, host, block, instance) (urnetwork_arin_database_build_epoch_seconds{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"} > 0)",
                    "legendFormat": "{{service}} {{host}} {{block}} {{instance}}"
                }
            ]
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "old ARIN database age by process",
            "description": "Time since the build of the old ARIN database each process opened beside its latest, the database the canary compares the latest against and serves when the breaker trips. A process with no old database loaded (missing, identical or invalid beside its latest, or not opened yet) reports 0 and is left out; the providers dashboard's canary row shows each process's slot states.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 54
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "time() - max by (service, host, block, instance) (urnetwork_arin_old_database_build_epoch_seconds{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"} > 0)",
                    "legendFormat": "{{service}} {{host}} {{block}} {{instance}}"
                }
            ]
        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "ARIN canary decision reads / s",
            "description": "Reads of the published ARIN canary decision by the request-time readers of each process (FindProviders2 Quality validation, provider status, the provider-egress counts and inspection), by outcome. A process reads at most once per 5 seconds. An absent or expired decision, or an invalid one, serves each provider's latest ARIN slot, as before the canary; a Redis error keeps the process's last decision for up to 15 minutes, then does the same. A sustained non-ok rate during a fallback means readers are not applying it.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 54
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, outcome) (rate(urnetwork_arindb_decision_reads_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "{{service}} {{outcome}}"
                }
            ]
        },
        {
            "id": 14,
            "type": "timeseries",
            "title": "ARIN lookup errors / s",
            "description": "Pair lookups of the connection address that failed in each process, by slot (arindbctl/ARINDB.md, Dual-database canary). A latest failure fails the connection's location write, so its provider never reaches the score cohort and the canary's comparison cannot see it: a release whose records fail to decode shows here, and as a cohort shrinking against its recent size on the providers dashboard. An old failure leaves that connection's old facts unavailable. Both are 0 in a healthy fleet.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 62
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, slot) (rate(urnetwork_arin_lookup_errors_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "{{service}} {{slot}}"
                }
            ]
        },
        {
            "id": 15,
            "type": "timeseries",
            "title": "ARIN lookup error share",
            "description": "The share of each service's pair lookups that failed, by slot. A background of failures, such as GeoLite2 misses on classifier-v0 records or unparseable addresses, is normal; the providers dashboard's cohort-shrink page needs more than 1% of latest lookups failing across the fleet, unless a new pair explains the shrink.",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 62
            },
            "datasource": {
                "type": "prometheus",
                "uid": "warp-mimir"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "min": 0
                },
                "overrides": []
            },
            "options": {
                "legend": {
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (service, slot) (rate(urnetwork_arin_lookup_errors_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval])) / sum by (service, slot) (rate(urnetwork_arin_lookups_total{env=\"$env\",service=~\"$service\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
                    "legendFormat": "{{service}} {{slot}}"
                }
            ]
        }
    ]
}
