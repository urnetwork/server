    {
      "type": "text",
      "title": "tracker definitions and research source",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 74
      },
      "options": {
        "mode": "markdown",
        "content": "Each send is deduplicated by network + flow step. Delivery corrections are accepted for 30 days. Product engagement belongs to the most recent preceding email until the next send, capped at 14 days. All charts select exactly one fresh taskworker snapshot; a missing or stale exporter remains **no data**, not a false zero. Open-only activity is shown but is not `engaged`. `attribution_ambiguous` is the number of networks with historical template-only evidence that could belong to more than one flow step. Research clients use the authenticated aggregate endpoint `GET /admin/onboarding/email-tracker?from=YYYY-MM-DD&to=YYYY-MM-DD` with optional `step`, `experiment`, `platform`, `path`, `cursor`, and `limit`."
      }
    },
    {
      "type": "stat",
      "title": "tracker snapshot age",
      "description": "Must remain below 20 minutes. No series means no taskworker has completed the tracker sync.",
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 79
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1200}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "warp-mimir"},
          "expr": "time() - max(urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "networks sent",
      "description": "Distinct network/flow-step exposures in the rolling 28-day send cohort.",
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 79},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "warp-mimir"},
          "expr": "sum(urnetwork_onboarding_email_tracker_networks{env=\"$env\",outcome=\"sent\"} and on(env,service,block,host,instance) topk(1, (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} > time() - 1200) and (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} <= time() + 30)))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "high-intent engagement rate",
      "description": "Engaged networks divided by sent networks; mailbox-open-only activity is excluded.",
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 79},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "warp-mimir"},
          "expr": "sum(urnetwork_onboarding_email_tracker_networks{env=\"$env\",outcome=\"engaged\"} and on(env,service,block,host,instance) topk(1, (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} > time() - 1200) and (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} <= time() + 30))) / clamp_min(sum(urnetwork_onboarding_email_tracker_networks{env=\"$env\",outcome=\"sent\"} and on(env,service,block,host,instance) topk(1, (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} > time() - 1200) and (urnetwork_onboarding_email_tracker_snapshot_timestamp_seconds{env=\"$env\",service=\"taskworker\"} <= time() + 30))), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "ambiguous legacy attribution",
