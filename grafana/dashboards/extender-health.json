          "refId": "A",
          "legendFormat": "online"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          },
          "expr": "max(urnetwork_stats_extender_gossip_extenders_24h{env=\"$env\",kind=\"record\"})",
          "refId": "B",
          "legendFormat": "released through gossip, 24h"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          },
          "expr": "max(urnetwork_taskworker_extender_dns_extenders{env=\"$env\"})",
          "refId": "C",
          "legendFormat": "in dns"
        }
      ],
      "description": "The online extenders beside the extenders whose record reached clients: through gossip in the last day, and in the dns sets of the last tick. A gap between online and released is extenders whose record has expired in every gossip-fed directory."
    },
    {
      "id": 7,
