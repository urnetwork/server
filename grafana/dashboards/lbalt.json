      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "request body buffers: memory and spill",
      "description": "Bytes of buffered request bodies held in memory and spilled to disk.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
