    {
      "id": 16,
      "type": "timeseries",
      "title": "request body spill files",
      "description": "Spill files open.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
