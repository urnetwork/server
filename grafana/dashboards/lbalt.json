{
  "uid": "urnetwork-lbalt",
  "title": "urnetwork / lb_alt front",
  "tags": [
    "urnetwork"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_front_requests_total, env)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "block",
        "label": "block",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_front_requests_total{env=\"$env\"}, block)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_front_requests_total{env=\"$env\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "front requests / s by service and status",
      "description": "Requests the lb_alt fronts served, by upstream service and status class (LBALT.md, LBALTOPT1 \u00a73.4).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream_service, status_class) (rate(urnetwork_front_requests_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{upstream_service}} {{status_class}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "front response header time by service",
      "description": "Time to the upstream's response header, excluding 1xx and requests with no response.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (upstream_service, le) (rate(urnetwork_front_response_header_seconds_bucket{env=\"$env\",block=~\"$block\",host=~\"$host\",status_class!~\"1xx|none\"}[$__rate_interval])))",
          "legendFormat": "p50 {{upstream_service}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (upstream_service, le) (rate(urnetwork_front_response_header_seconds_bucket{env=\"$env\",block=~\"$block\",host=~\"$host\",status_class!~\"1xx|none\"}[$__rate_interval])))",
          "legendFormat": "p99 {{upstream_service}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "limit refusals / s by limit and zone",
      "description": "Requests and QUIC connections the per-address limits refused (LBALTOPT2 \u00a73.7).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (limit, zone) (rate(urnetwork_front_limit_refusals_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{limit}} {{zone}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "TLS handshakes / s: completed and failed",
      "description": "Completed TLS handshakes over TCP, and the front's HTTP server errors with their reasons.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (version, resumed, alpn) (rate(urnetwork_connect_front_tls_handshakes_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "completed {{version}} resumed={{resumed}} {{alpn}}"
        },
        {
          "refId": "B",
          "expr": "sum by (kind, reason) (rate(urnetwork_connect_front_http_server_errors_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "failed {{kind}} {{reason}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "QUIC connections / s by port, result and reason",
      "description": "Accepted public QUIC connections: handed to api or connect, refused by the cap, or failed handshakes with their reason.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (port, result, reason) (rate(urnetwork_connect_front_quic_connections_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{port}} {{result}} {{reason}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "QUIC connections / s by address family",
      "description": "The same connections by IPv4 or IPv6 (LBALTOPT2 \u00a73.8).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (port, family, result) (rate(urnetwork_connect_front_quic_connections_by_family_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{port}} {{family}} {{result}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "QUIC handshakes completed / s",
      "description": "Completed QUIC handshakes by port, QUIC version and resumption.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (port, version, resumed) (rate(urnetwork_connect_front_quic_handshakes_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{port}} {{version}} resumed={{resumed}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "QUIC ClientHellos / s by name class",
      "description": "Every QUIC ClientHello by port, the class of name it presented, and whether it offered h3.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (port, name_class, h3_offered) (rate(urnetwork_front_quic_client_hellos_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{port}} {{name_class}} h3={{h3_offered}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "front sockets: up, restarts and bind failures",
      "description": "Front sockets bound per host, and their restarts and bind failures.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host) (urnetwork_connect_front_sockets_up{env=\"$env\",block=~\"$block\",host=~\"$host\"})",
          "legendFormat": "up {{host}}"
        },
        {
          "refId": "B",
          "expr": "sum by (host) (increase(urnetwork_connect_front_socket_restarts_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "restarts {{host}}"
        },
        {
          "refId": "C",
          "expr": "sum by (host) (increase(urnetwork_connect_front_socket_bind_failures_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "bind failures {{host}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "certificate days left, and pprof listeners",
      "description": "Days until the soonest front certificate expires, and connect processes serving loopback pprof (LBALTOPT1 Appendix C).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min by (host) (urnetwork_front_certificate_expiry_timestamp_seconds{env=\"$env\",block=~\"$block\",host=~\"$host\"}) - time()) / 86400",
          "legendFormat": "days left {{host}}"
        },
        {
          "refId": "B",
          "expr": "count by (host) (urnetwork_connect_pprof_port{env=\"$env\",block=~\"$block\",host=~\"$host\"})",
          "legendFormat": "pprof listeners {{host}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "upstream attempts and retries / s",
      "description": "Forwarded requests' upstream attempts by result, and retries by reason.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream_service, result) (rate(urnetwork_lbalt_upstream_attempts_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{upstream_service}} {{result}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(urnetwork_lbalt_upstream_retries_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "retry {{reason}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "upstream connections / s: reused, dialed, failed",
      "description": "Upstream connection reuse against new dials (LBALTOPT1 R11).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (upstream_service, result) (rate(urnetwork_lbalt_upstream_connections_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{upstream_service}} {{result}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "forward errors and body refusals / s",
      "description": "Forwarding errors, and request bodies refused as incomplete, canceled or timed out.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(urnetwork_lbalt_forward_errors_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "forward errors"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(urnetwork_lbalt_forward_body_refusals_total{env=\"$env\",block=~\"$block\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "body refused {{reason}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "forward tunnels",
      "description": "Open forwarded tunnels (websockets to gossip, grafana live).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
