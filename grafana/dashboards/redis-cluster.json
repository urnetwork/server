{
  "uid": "urnetwork-redis-cluster",
  "title": "urnetwork / redis cluster",
  "description": "Redis cluster health: per-node (redis_exporter multi-target scrape, one series set per cluster node labeled node=<port>) and app-side connection pools (urnetwork_redis_pool_* pushed by the services). Alert rules for these panels are provisioned by the warp grafana service (warp/grafana/alerting/redis-cluster.yml).",
  "tags": [
    "urnetwork",
    "redis"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(redis_up, env)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(redis_up{env=\"$env\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(redis_up{env=\"$env\",host=~\"$host\"}, node)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "cluster status",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "nodes up",
      "description": "Cluster nodes whose exporter target reports redis_up == 1.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (host, node) (redis_up{env=\"$env\"}) == 1) or on() vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "nodes down",
      "description": "Cluster nodes reporting redis_up == 0. A node that stops being scraped entirely drops out of 'nodes up' instead.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (host, node) (redis_up{env=\"$env\"}) == 0) or on() vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "cluster state not ok",
      "description": "Nodes reporting CLUSTER INFO cluster_state != ok (redis_cluster_state < 1). Any nonzero value means the cluster is not serving all slots from this node's view.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(min by (host, node) (redis_cluster_state{env=\"$env\"}) < 1) or on() vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "bgsaves in progress",
      "description": "Concurrent BGSAVE forks across the cluster (sum of redis_rdb_bgsave_in_progress). Sustained high counts (fork storm) compete for memory and disk io.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(redis_rdb_bgsave_in_progress{env=\"$env\"}) or on() vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "busiest main thread",
      "description": "Highest main-thread CPU of any Redis node: user plus system seconds per second of the thread that runs commands and accepts connections, over five minutes (1.0 is one full core, all that thread can use). Orange from 0.85: the WARN of SIGNALS.md section 26 needs 10 minutes above it. Healthy is at most 0.64. In the 2026-10-26 storm single nodes ran 0.97-0.98, mostly on connection handling.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (host, node) (rate(redis_cpu_user_main_thread_seconds_total{env=\"$env\"}[5m])) + sum by (host, node) (rate(redis_cpu_sys_main_thread_seconds_total{env=\"$env\"}[5m])))"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "highest HELLO rate on one node",
      "description": "Highest per-node rate of HELLO over five minutes. go-redis opens every new connection with HELLO, so this is connection churn. Orange from 500/s: the WARN of SIGNALS.md section 26 needs 5 minutes above it. Healthy is at most 12/s; thousands per second on single nodes in the 2026-10-26 storm, when the proxies' Redis clients reconnected after timeouts.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(redis_commands_total{env=\"$env\",cmd=\"hello\"}[5m]))"
        }
      ]
    },
    {
      "id": 22,
      "type": "stat",
      "title": "highest client pool timeouts (one service)",
      "description": "Highest rate of go-redis pool timeouts of any service over five minutes (urnetwork_redis_pool_timeouts_total, summed over the service's processes): commands that waited past the pool timeout for a connection. Orange from 10/s, the WARN of SIGNALS.md section 26 after 5 minutes; red from 1,000/s, the PAGE of SIGNALS.md section 3.5b. Healthy is 0. The proxy reached 12-14k/s in the 2026-10-26 storm.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 1000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (service) (rate(urnetwork_redis_pool_timeouts_total{env=\"$env\",instance!=\"\"}[5m])))"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "highest client pool misses (one service)",
      "description": "Highest rate of pool checkouts of any service that found no idle connection and dialed a new one, over five minutes. Tens per second or less is normal; thousands per second means a service is reconnecting, which the nodes show as HELLO and accepted connections. No SIGNALS.md section 26 threshold.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(sum by (service) (rate(urnetwork_redis_pool_misses_total{env=\"$env\",instance!=\"\"}[5m])))"
        }
      ]
    },
    {
      "id": 24,
      "type": "row",
      "title": "main thread and connection churn",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "main-thread CPU per node",
      "description": "Per-node main-thread CPU, user plus system seconds per second over five minutes (redis_cpu_user/sys_main_thread_seconds_total); 1.0 is one full core, all the main thread can use. The line is the WARN of SIGNALS.md section 26: 0.85 for 10 minutes. A saturated main thread delays every command on its node, whether the time goes to commands or to accepting connections: compare ops / s and HELLO / s.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, node) (rate(redis_cpu_user_main_thread_seconds_total{env=\"$env\",host=~\"$host\",node=~\"$node\"}[5m])) + sum by (host, node) (rate(redis_cpu_sys_main_thread_seconds_total{env=\"$env\",host=~\"$host\",node=~\"$node\"}[5m]))",
          "legendFormat": "{{host}} {{node}}"
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "HELLO / s per node",
      "description": "HELLO commands per node per second over five minutes. go-redis opens every new connection with HELLO, so this is connection churn. The line is the WARN of SIGNALS.md section 26: 500/s for 5 minutes. Reconnect storms, from timeouts that close connections or from pool misses, show here before the main thread saturates.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 500
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, node) (rate(redis_commands_total{env=\"$env\",host=~\"$host\",node=~\"$node\",cmd=\"hello\"}[5m]))",
          "legendFormat": "{{host}} {{node}}"
        }
      ]
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "connections accepted / s per node",
      "description": "New client connections each node accepted per second over five minutes (redis_connections_received_total). For go-redis clients it tracks HELLO; accepted connections well above HELLO are connections that closed before their handshake.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, node) (rate(redis_connections_received_total{env=\"$env\",host=~\"$host\",node=~\"$node\"}[5m]))",
          "legendFormat": "{{host}} {{node}}"
        }
      ]
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "client pool misses / s by service",
      "description": "Checkouts that found no idle pooled connection and dialed a new one, per service (urnetwork_redis_pool_misses_total). Each miss is a new connection on some node, so the service whose misses rise with the nodes' HELLO and accepted connections is the one churning.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(urnetwork_redis_pool_misses_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "per node",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "memory fill %",
      "description": "redis_memory_used_bytes / redis_memory_max_bytes per node. Nodes with maxmemory unset (0) are hidden. Threshold lines at the 85% warn / 92% page alert levels.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "auto",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 92
              }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
