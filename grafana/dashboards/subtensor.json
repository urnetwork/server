{
  "uid": "urnetwork-subtensor",
  "title": "urnetwork / subtensor",
  "description": "Bittensor Subtensor archive- and lightnode health: chain progress and finality, sync state, peers, transaction pool, RPC sessions, caches, and host pressure.",
  "tags": ["urnetwork", "subtensor", "bittensor", "infrastructure"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(substrate_block_height{job=~\"subtensor(|-lightnode)\"}, env)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "host",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(substrate_block_height{env=\"$env\",job=~\"subtensor(|-lightnode)\"}, host)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(substrate_block_height{env=\"$env\",host=~\"$host\",job=~\"subtensor(|-lightnode)\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      },
      {
        "name": "chain",
        "label": "chain",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "warp-mimir"},
        "query": "label_values(substrate_block_height{env=\"$env\",host=~\"$host\",job=~\"$node\"}, chain)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "best block",
      "description": "Highest imported block on the selected node.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "locale"}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max by (job) (substrate_block_height{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\",status=\"best\"})", "legendFormat": "{{job}}", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 2,
      "title": "finality lag",
      "description": "Best minus finalized block. Sustained growth means finality or sync trouble.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 64}, {"color": "red", "value": 256}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max by (job) (substrate_block_height{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\",status=\"best\"}) - max by (job) (substrate_block_height{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\",status=\"finalized\"})", "legendFormat": "{{job}}", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 3,
      "title": "connected peers",
      "description": "Libp2p/litep2p peers. Zero means the selected node cannot advance.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 1}, {"color": "green", "value": 5}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max by (job) (substrate_sub_libp2p_peers_count{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}}", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 4,
      "title": "major syncing",
      "description": "1 while the node is in major sync, 0 when converged.",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "options": {"0": {"text": "converged", "color": "green"}, "1": {"text": "syncing", "color": "orange"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"refId": "A", "expr": "max by (job) (substrate_sub_libp2p_is_major_syncing{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}}", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 5,
      "title": "chain height",
      "description": "Best and finalized heads. Both must keep advancing; the distance between them is finality lag.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "locale", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "max by (job, host, status) (substrate_block_height{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} {{status}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 6,
      "title": "peers",
      "description": "Connected and discovered peer population over time.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "min"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "max by (job, host) (substrate_sub_libp2p_peers_count{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} connected", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "max by (job, host) (substrate_sub_libp2p_peerset_num_discovered{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} discovered", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 7,
      "title": "network throughput",
      "description": "Subtensor peer-network traffic by direction.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "Bps", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (job, host, direction) (rate(substrate_sub_libp2p_network_bytes_total{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"}[$__rate_interval]))", "legendFormat": "{{job}} {{host}} {{direction}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 8,
      "title": "transaction pool",
      "description": "Ready transaction count. A queue that only grows indicates block import or execution trouble.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "max by (job, host) (substrate_ready_transactions_number{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} ready", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 9,
      "title": "RPC sessions",
      "description": "Currently open persistent RPC sessions, derived from opened minus closed counters.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "sum by (job, host) (substrate_rpc_sessions_opened{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"}) - sum by (job, host) (substrate_rpc_sessions_closed{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 10,
      "title": "node caches",
      "description": "Substrate state and database cache memory.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "sum by (job, host) (substrate_state_cache_bytes{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} state", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "sum by (job, host) (substrate_database_cache_bytes{env=\"$env\",host=~\"$host\",chain=~\"$chain\",job=~\"$node\"})", "legendFormat": "{{job}} {{host}} database", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    },
    {
      "id": 11,
      "title": "node data disk used",
      "description": "Host root-filesystem consumption by the archive and lightnode databases.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{env=\"$env\",host=~\"$host\",job=\"node\",mountpoint=\"/\"} / node_filesystem_size_bytes{env=\"$env\",host=~\"$host\",job=\"node\",mountpoint=\"/\"})", "legendFormat": "{{host}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}]
    },
    {
      "id": 12,
      "title": "host CPU and memory used",
      "description": "Host pressure beside chain-specific signals.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "datasource": {"type": "prometheus", "uid": "warp-mimir"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": false, "axisPlacement": "auto", "stacking": {"mode": "none", "group": "A"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"refId": "A", "expr": "100 * (1 - avg by (host) (rate(node_cpu_seconds_total{env=\"$env\",host=~\"$host\",job=\"node\",mode=\"idle\"}[$__rate_interval])))", "legendFormat": "{{host}} cpu", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}},
        {"refId": "B", "expr": "100 * (1 - node_memory_MemAvailable_bytes{env=\"$env\",host=~\"$host\",job=\"node\"} / node_memory_MemTotal_bytes{env=\"$env\",host=~\"$host\",job=\"node\"})", "legendFormat": "{{host}} memory", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "warp-mimir"}}
      ]
    }
  ]
}
