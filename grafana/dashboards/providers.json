{
  "uid": "urnetwork-providers",
  "title": "urnetwork / providers",
  "description": "The supply side of the network and the contracts it carries: the provider and extender populations with their ip family splits, the contract and dispute counts open now and over the trailing 24 hours, and the countries with the most of each. Internal: the contract counts are not published. Every gauge is replicated by every taskworker and read with max, so no panel needs a block or host variable.",
  "tags": [
    "urnetwork",
    "providers"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "warp-mimir"
        },
        "query": "label_values(urnetwork_stats_online_providers, env)",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "population",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "online providers",
      "datasource": {
        "type": "prometheus",
        "uid": "warp-mimir"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8b7be6"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "warp-mimir"
          },
          "expr": "max(urnetwork_stats_online_providers{env=\"$env\"})",
          "refId": "A",
          "legendFormat": "providers"
        }
      ],
      "description": "Connected valid providers holding a public provide key. Every taskworker publishes the same measurement, so max selects it without replica skew."
    },
