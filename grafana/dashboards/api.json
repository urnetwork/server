{
  "uid": "urnetwork-api",
  "title": "urnetwork / api",
  "description": "Authenticated API deep dive. Routes are finite configured router IDs, never request paths. Active authenticated networks are process-local rolling aggregates and may duplicate across replicas; the separate contract-user panel is network activity, not API callers. Missing or stale telemetry remains no-data.",
  "tags": ["urnetwork"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {"list": [
    {"name": "env", "label": "env", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready, env)", "refresh": 2, "sort": 1},
    {"name": "block", "label": "block", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready{env=\"$env\"}, block)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true},
    {"name": "host", "label": "host", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready{env=\"$env\",block=~\"$block\"}, host)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "ready instances", "description": "Migration-aware API instances currently admitted and not draining.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_api_ready{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 2, "type": "stat", "title": "draining instances", "description": "Instances inside the bounded HTTP drain sequence.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_http_server_draining{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 3, "type": "stat", "title": "requests / s", "description": "Completed API requests across finite configured routes and fixed 404/405 handlers.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "instant": true, "range": false}]},
    {"id": 4, "type": "stat", "title": "requests in flight", "description": "Requests currently inside API handlers, including fixed unmatched handlers.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_http_requests_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},

    {"id": 5, "type": "timeseries", "title": "request rate by configured route", "description": "No raw URL or caller-controlled path is retained as a label.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}}"}]},
    {"id": 6, "type": "timeseries", "title": "exact status codes by route", "description": "Exact numeric response status for each bounded route; a none series identifies a panic, abort, cancellation, or hijack without a written status.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, status) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}} {{status}}"}]},
    {"id": 7, "type": "timeseries", "title": "terminal outcomes by route", "description": "Finite outcomes distinguish completed, canceled, panic, aborted, not_found (404), and method_not_allowed (405) requests.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, outcome) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\",outcome=~\"completed|canceled|panic|aborted|not_found|method_not_allowed\"}[$__rate_interval]))", "legendFormat": "{{route}} {{outcome}}"}]},
    {"id": 8, "type": "timeseries", "title": "404 and 405 request rate", "description": "Unmatched route and method traffic remains separate and never creates a raw-path label.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, status, outcome) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\",route=~\"not_found|method_not_allowed\",status=~\"404|405\"}[$__rate_interval]))", "legendFormat": "{{status}} {{outcome}}"}]},

    {"id": 9, "type": "timeseries", "title": "request and response bytes / s", "description": "Request bytes are bytes handlers actually consume; response bytes are bytes successfully written. Neither includes headers.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_bytes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "request {{route}}"}, {"refId": "B", "expr": "sum by (route) (rate(urnetwork_http_response_bytes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "response {{route}}"}]},
    {"id": 10, "type": "timeseries", "title": "mean response time by route", "description": "Rate-derived mean handler duration by bounded route.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_duration_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum by (route) (rate(urnetwork_http_request_duration_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}}"}]},
    {"id": 11, "type": "timeseries", "title": "p95 and p99 response time", "description": "Fleet histogram quantiles; values are estimates from bounded buckets.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(urnetwork_http_request_duration_seconds_bucket{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p95 {{route}}"}, {"refId": "B", "expr": "histogram_quantile(0.99, sum by (le, route) (rate(urnetwork_http_request_duration_seconds_bucket{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])))", "legendFormat": "p99 {{route}}"}]},
    {"id": 12, "type": "timeseries", "title": "fresh one-minute maximum response time", "description": "Exact process maxima only while the owning observation timestamp is within 120 seconds; inactivity or missing telemetry remains no-data.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max by (route) (urnetwork_http_request_interval_max_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} and on (env, service, block, host, instance, route) (urnetwork_http_request_interval_max_timestamp_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} > time() - 120 and urnetwork_http_request_interval_max_timestamp_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} < time() + 30))", "legendFormat": "{{route}}"}]},

    {"id": 13, "type": "timeseries", "title": "authentication attempts", "description": "Actual API session authentication decisions by bounded credential method and outcome; no identity labels.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (method, outcome) (rate(urnetwork_session_auth_attempts_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{method}} {{outcome}}"}]},
    {"id": 14, "type": "timeseries", "title": "active authenticated networks (process-local)", "description": "Rolling distinct authenticated network principals per API process. Max by window avoids inventing a fleet-distinct total; callers can appear on multiple replicas.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max by (window) (urnetwork_session_active_authenticated_networks{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{window}} process maximum"}]},
    {"id": 15, "type": "timeseries", "title": "network contract users (not API callers)", "description": "Unique top-level identities with contract usage in rolling 24h from the authoritative stats snapshot. This is broader network engagement and must not be interpreted as API users.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max(urnetwork_stats_users_24h{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "contract users"}]},
    {"id": 16, "type": "timeseries", "title": "Postgres pool saturation", "description": "Used, idle, total, and configured maximum connections per initialized API pool.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (pool, state) (urnetwork_pg_pool_connections{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{pool}} {{state}}"}]},
    {"id": 17, "type": "timeseries", "title": "Postgres acquire pressure", "description": "Pool acquire outcomes, wait time, connection churn and bounded destruction reasons.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (pool, outcome) (rate(urnetwork_pg_pool_acquires_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "acquire {{pool}} {{outcome}}"}, {"refId": "B", "expr": "sum by (pool) (rate(urnetwork_pg_pool_acquire_duration_seconds_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "wait seconds/s {{pool}}"}, {"refId": "C", "expr": "sum by (pool) (rate(urnetwork_pg_pool_connections_created_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "created {{pool}}"}, {"refId": "D", "expr": "sum by (pool, reason) (rate(urnetwork_pg_pool_connections_destroyed_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "destroyed {{pool}} {{reason}}"}]},
    {"id": 18, "type": "timeseries", "title": "Redis pool saturation and wait", "description": "Connection occupancy plus hit, miss, and timeout rates from API Redis clients.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_redis_pool_total_conns{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "total"}, {"refId": "B", "expr": "sum(urnetwork_redis_pool_idle_conns{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "idle"}, {"refId": "C", "expr": "sum(rate(urnetwork_redis_pool_misses_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "misses/s"}, {"refId": "D", "expr": "sum(rate(urnetwork_redis_pool_hits_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "hits/s"}, {"refId": "E", "expr": "sum(rate(urnetwork_redis_pool_timeouts_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "timeouts/s"}]},
    {"id": 19, "type": "timeseries", "title": "process CPU, memory, and goroutines", "description": "API process saturation controls by selected deploy block and host.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(process_cpu_seconds_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "CPU cores"}, {"refId": "B", "expr": "sum(process_resident_memory_bytes{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "RSS bytes"}, {"refId": "C", "expr": "sum(go_goroutines{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "goroutines"}]},
    {"id": 20, "type": "timeseries", "title": "HTTP drain outcomes", "description": "Last drain duration, handlers active at drain start, and connections hard-cut at deadline. Values only exist after an observed lifecycle.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max(urnetwork_http_server_drain_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "duration seconds"}, {"refId": "B", "expr": "sum(urnetwork_http_server_drain_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "inflight at start"}, {"refId": "C", "expr": "sum(urnetwork_http_server_drain_cut_connections{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "hard cut"}]}
  ]
}
