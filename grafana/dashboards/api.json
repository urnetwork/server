{
  "uid": "urnetwork-api",
  "title": "urnetwork / api",
  "description": "Authenticated API deep dive. Routes are finite configured router IDs, never request paths. Active authenticated networks are process-local rolling aggregates and may duplicate across replicas; the separate contract-user panel is network activity, not API callers. Missing or stale telemetry remains no-data.",
  "tags": ["urnetwork"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "templating": {"list": [
    {"name": "env", "label": "env", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready, env)", "refresh": 2, "sort": 1},
    {"name": "block", "label": "block", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready{env=\"$env\"}, block)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true},
    {"name": "host", "label": "host", "type": "query", "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "query": "label_values(urnetwork_api_ready{env=\"$env\",block=~\"$block\"}, host)", "refresh": 2, "sort": 1, "multi": true, "includeAll": true}
  ]},
  "panels": [
    {"id": 1, "type": "stat", "title": "ready instances", "description": "Migration-aware API instances currently admitted and not draining.", "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_api_ready{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 2, "type": "stat", "title": "draining instances", "description": "Instances inside the bounded HTTP drain sequence.", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_http_server_draining{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},
    {"id": 3, "type": "stat", "title": "requests / s", "description": "Completed API requests across finite configured routes and fixed 404/405 handlers.", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "instant": true, "range": false}]},
    {"id": 4, "type": "stat", "title": "requests in flight", "description": "Requests currently inside API handlers, including fixed unmatched handlers.", "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_http_requests_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "instant": true, "range": false}]},

    {"id": 5, "type": "timeseries", "title": "request rate by configured route", "description": "No raw URL or caller-controlled path is retained as a label.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}}"}]},
    {"id": 6, "type": "timeseries", "title": "exact status codes by route", "description": "Exact numeric response status for each bounded route; a none series identifies a panic, abort, cancellation, or hijack without a written status.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, status) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}} {{status}}"}]},
    {"id": 7, "type": "timeseries", "title": "terminal outcomes by route", "description": "Finite outcomes distinguish completed, canceled, panic, aborted, not_found (404), and method_not_allowed (405) requests.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, outcome) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\",outcome=~\"completed|canceled|panic|aborted|not_found|method_not_allowed\"}[$__rate_interval]))", "legendFormat": "{{route}} {{outcome}}"}]},
    {"id": 8, "type": "timeseries", "title": "404 and 405 request rate", "description": "Unmatched route and method traffic remains separate and never creates a raw-path label.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route, status, outcome) (rate(urnetwork_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\",route=~\"not_found|method_not_allowed\",status=~\"404|405\"}[$__rate_interval]))", "legendFormat": "{{status}} {{outcome}}"}]},

    {"id": 9, "type": "timeseries", "title": "request and response bytes / s", "description": "Request bytes are bytes handlers actually consume; response bytes are bytes successfully written. Neither includes headers.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_bytes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "request {{route}}"}, {"refId": "B", "expr": "sum by (route) (rate(urnetwork_http_response_bytes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "response {{route}}"}]},
    {"id": 10, "type": "timeseries", "title": "mean response time by route", "description": "Rate-derived mean handler duration by bounded route.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 21}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (route) (rate(urnetwork_http_request_duration_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / sum by (route) (rate(urnetwork_http_request_duration_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{route}}"}]},
    {"id": 12, "type": "timeseries", "title": "fresh one-minute maximum response time", "description": "Exact process maxima only while the owning observation timestamp is within 120 seconds; inactivity or missing telemetry remains no-data.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 29}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max by (route) (urnetwork_http_request_interval_max_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} and on (env, service, block, host, instance, route) (urnetwork_http_request_interval_max_timestamp_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} > time() - 120 and urnetwork_http_request_interval_max_timestamp_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"} < time() + 30))", "legendFormat": "{{route}}"}]},

    {"id": 13, "type": "timeseries", "title": "authentication attempts", "description": "Actual API session authentication decisions by bounded credential method and outcome; no identity labels.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (method, outcome) (rate(urnetwork_session_auth_attempts_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{method}} {{outcome}}"}]},
    {"id": 14, "type": "timeseries", "title": "active authenticated networks (process-local)", "description": "Rolling distinct authenticated network principals per API process. Max by window avoids inventing a fleet-distinct total; callers can appear on multiple replicas.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 37}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max by (window) (urnetwork_session_active_authenticated_networks{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{window}} process maximum"}]},
    {"id": 15, "type": "timeseries", "title": "network contract users (not API callers)", "description": "Unique top-level identities with contract usage in rolling 24h from the authoritative stats snapshot. This is broader network engagement and must not be interpreted as API users.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max(urnetwork_stats_users_24h{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "contract users"}]},
    {"id": 16, "type": "timeseries", "title": "Postgres pool saturation", "description": "Used, idle, total, and configured maximum connections per initialized API pool.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 45}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (pool, state) (urnetwork_pg_pool_connections{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{pool}} {{state}}"}]},
    {"id": 17, "type": "timeseries", "title": "Postgres acquire pressure", "description": "Pool acquire outcomes, wait time, connection churn and bounded destruction reasons.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum by (pool, outcome) (rate(urnetwork_pg_pool_acquires_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "acquire {{pool}} {{outcome}}"}, {"refId": "B", "expr": "sum by (pool) (rate(urnetwork_pg_pool_acquire_duration_seconds_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "wait seconds/s {{pool}}"}, {"refId": "C", "expr": "sum by (pool) (rate(urnetwork_pg_pool_connections_created_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "created {{pool}}"}, {"refId": "D", "expr": "sum by (pool, reason) (rate(urnetwork_pg_pool_connections_destroyed_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "destroyed {{pool}} {{reason}}"}]},
    {"id": 18, "type": "timeseries", "title": "Redis pool saturation and wait", "description": "Connection occupancy plus hit, miss, and timeout rates from API Redis clients.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 53}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(urnetwork_redis_pool_total_conns{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "total"}, {"refId": "B", "expr": "sum(urnetwork_redis_pool_idle_conns{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "idle"}, {"refId": "C", "expr": "sum(rate(urnetwork_redis_pool_misses_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "misses/s"}, {"refId": "D", "expr": "sum(rate(urnetwork_redis_pool_hits_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "hits/s"}, {"refId": "E", "expr": "sum(rate(urnetwork_redis_pool_timeouts_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "timeouts/s"}]},
    {"id": 19, "type": "timeseries", "title": "process CPU, memory, and goroutines", "description": "API process saturation controls by selected deploy block and host.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "sum(rate(process_cpu_seconds_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "CPU cores"}, {"refId": "B", "expr": "sum(process_resident_memory_bytes{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "RSS bytes"}, {"refId": "C", "expr": "sum(go_goroutines{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "goroutines"}]},
    {"id": 20, "type": "timeseries", "title": "HTTP drain outcomes", "description": "Last drain duration, handlers active at drain start, and connections hard-cut at deadline. Values only exist after an observed lifecycle.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 61}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "targets": [{"refId": "A", "expr": "max(urnetwork_http_server_drain_seconds{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "duration seconds"}, {"refId": "B", "expr": "sum(urnetwork_http_server_drain_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "inflight at start"}, {"refId": "C", "expr": "sum(urnetwork_http_server_drain_cut_connections{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "hard cut"}]},
    {"id": 21, "type": "row", "title": "URL Due handler phases (paced URL probe scheduling)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 69}},
    {"id": 22, "type": "timeseries", "title": "URL Due requests / s by terminal outcome", "description": "Validated URL Due requests by bounded handler outcome. A returned request is not a delivered response, an executed probe or an accepted receipt. Claims arrive over the operator API or, from a taskworker whose operator_transport is local, through its in-process operator; both publish these series. The second series counts processes that expose request-scoped phase timing; a process without it is absent, not zero.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 70}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (outcome) (rate(urnetwork_url_due_requests_total{env=\"$env\",service=~\"api|taskworker\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{outcome}}"}, {"refId": "B", "expr": "sum(urnetwork_url_due_timing_enabled{env=\"$env\",service=~\"api|taskworker\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "processes with phase timing"}]},
    {"id": 23, "type": "timeseries", "title": "URL Due phase observations / s", "description": "Phase observations including failed and rolled-back attempts. Database phases count each retry; model and admitted_handler count each request once.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 70}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (phase) (rate(urnetwork_url_due_phase_observations_total{env=\"$env\",service=~\"api|taskworker\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{phase}}"}]},
    {"id": 24, "type": "timeseries", "title": "URL Due mean phase wall time", "description": "Cumulative client wall time per observation for each phase. Nested phases are inclusive and must not be summed; query phases include protocol and decoding time.", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 78}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (phase) (rate(urnetwork_url_due_phase_seconds_total{env=\"$env\",service=~\"api|taskworker\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (phase) (rate(urnetwork_url_due_phase_observations_total{env=\"$env\",service=~\"api|taskworker\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{phase}}"}]},
    {"id": 25, "type": "row", "title": "provider discovery diagnostics (FindProviders2 and the provider picker)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 86}},
    {"id": 26, "type": "timeseries", "title": "FindProviders2 selection outcomes / s", "description": "Request-local selection outcomes by terminal explanation, then by request class and rank mode. No target or caller identifiers are exported.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 87}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (outcome, reason) (rate(urnetwork_findproviders2_selection_outcomes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{outcome}} {{reason}}"}, {"refId": "B", "expr": "sum by (request_class, rank_mode) (rate(urnetwork_findproviders2_selection_outcomes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{request_class}} {{rank_mode}}"}]},
    {"id": 27, "type": "timeseries", "title": "FindProviders2 native source outcomes / s", "description": "Visited native bucket outcomes after request filters. unavailable is degraded priority, never proven exhaustion, even when the online fallback fills the response.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 87}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (rank_mode, source, outcome) (rate(urnetwork_findproviders2_native_source_outcomes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{rank_mode}} {{source}} {{outcome}}"}]},
    {"id": 28, "type": "timeseries", "title": "FindProviders2 mean stage residence", "description": "Stage residence including failed and canceled work, from the histogram sum and count. Subscriber validation is the primary-database validation inside one discovery request, including acquisition and query waits.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 95}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (stage) (rate(urnetwork_findproviders2_stage_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (stage) (rate(urnetwork_findproviders2_stage_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{stage}}"}, {"refId": "B", "expr": "sum by (outcome) (rate(urnetwork_findproviders2_subscriber_validation_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (outcome) (rate(urnetwork_findproviders2_subscriber_validation_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "subscriber validation {{outcome}}"}]},
    {"id": 29, "type": "timeseries", "title": "FindProviders2 work in flight", "description": "Selection requests currently inside each stage, and requests validating subscriber facts on the primary.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 95}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (stage) (urnetwork_findproviders2_stage_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{stage}}"}, {"refId": "B", "expr": "sum(urnetwork_findproviders2_subscriber_validation_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "subscriber validation"}]},
    {"id": 30, "type": "timeseries", "title": "subscriber eligibility and provider appearance events / s", "description": "Subscriber eligibility cache candidate events and SQL batch attempts (positive eligibility is never cached or counted here), and FindProviders2 provider appearances recorded in process, written to Redis or dropped.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 103}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (event) (rate(urnetwork_subscriber_eligibility_events_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "eligibility {{event}}"}, {"refId": "B", "expr": "sum by (event) (rate(urnetwork_provider_appearances_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "appearance {{event}}"}]},
    {"id": 31, "type": "timeseries", "title": "discovery capability and diagnostic schema by process", "description": "Per-process configuration, not request outcomes: the cached native-reader setting for non-forced discovery and the fixed diagnostic schema versions this process supports. Absent processes are no-data, not disabled.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 103}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "max by (host, block, instance) (urnetwork_findproviders2_native_reader_enabled{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "native reader {{host}} {{block}} {{instance}}"}, {"refId": "B", "expr": "max(urnetwork_findproviders2_native_source_schema_version{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "native source schema"}, {"refId": "C", "expr": "max(urnetwork_findproviders2_selection_schema_version{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "selection schema"}]},
    {"id": 32, "type": "timeseries", "title": "provider picker outcomes / s", "description": "Picker model outcomes by request surface and whether the rendered rows were empty. This is the model result, not HTTP delivery.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 111}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (surface, outcome) (rate(urnetwork_provider_picker_outcomes_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{surface}} {{outcome}}"}]},
    {"id": 33, "type": "timeseries", "title": "provider picker mean exclusive phase residence", "description": "Exclusive picker phase residence including errors and cancellation, from the summary sum and count; not HTTP delivery or server CPU.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 111}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (surface, phase) (rate(urnetwork_provider_picker_phase_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (surface, phase) (rate(urnetwork_provider_picker_phase_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{surface}} {{phase}}"}]},
    {"id": 34, "type": "timeseries", "title": "provider picker phases in flight", "description": "Picker model calls currently in each exclusive phase.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 119}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (surface, phase) (urnetwork_provider_picker_phase_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{surface}} {{phase}}"}]},
    {"id": 35, "type": "timeseries", "title": "picker and score Redis read failures / s", "description": "Non-missing Redis read or decode failures by phase: picker reads, and the client score pipeline including its optional backfill reads. Missing keys are not failures.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 119}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (phase) (rate(urnetwork_provider_picker_read_errors_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "picker {{phase}}"}, {"refId": "B", "expr": "sum by (phase) (rate(urnetwork_client_score_read_errors_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "score {{phase}}"}]},
    {"id": 36, "type": "row", "title": "connect control over HTTP (/connect/control)", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 127}},
    {"id": 37, "type": "timeseries", "title": "control HTTP requests / s by source, final phase and outcome", "description": "Handler invocations including retries. source is the spoofable probe marker and grants nothing; outcomes are not authorization or ACK evidence.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 128}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (source, phase, outcome) (rate(urnetwork_connect_control_http_requests_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{source}} {{phase}} {{outcome}}"}]},
    {"id": 38, "type": "timeseries", "title": "control HTTP phase exits / s", "description": "Phase exits including canceled and panicking requests before frame dispatch.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 128}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (phase, outcome) (rate(urnetwork_connect_control_http_phase_completions_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{phase}} {{outcome}}"}]},
    {"id": 39, "type": "timeseries", "title": "control HTTP mean residence", "description": "Mean handler residence by probe marker and mean phase residence, from the summary sums and counts, including failed and canceled calls. A mean, not a quantile.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 136}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (source) (rate(urnetwork_connect_control_http_request_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (source) (rate(urnetwork_connect_control_http_request_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "request {{source}}"}, {"refId": "B", "expr": "sum by (phase) (rate(urnetwork_connect_control_http_phase_seconds_sum{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])) / clamp_min(sum by (phase) (rate(urnetwork_connect_control_http_phase_seconds_count{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval])), 1e-9)", "legendFormat": "phase {{phase}}"}]},
    {"id": 40, "type": "timeseries", "title": "control HTTP requests and phases in flight", "description": "Handler invocations in flight by probe marker, and requests in each phase including time waiting for dependencies. Observation has no admission or authorization effect.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 136}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (source) (urnetwork_connect_control_http_requests_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "requests {{source}}"}, {"refId": "B", "expr": "sum by (phase) (urnetwork_connect_control_http_phase_inflight{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "phase {{phase}}"}]},
    {"id": 41, "type": "row", "title": "payments, messages, leads and upload admission", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 144}},
    {"id": 42, "type": "timeseries", "title": "payment, receipt and lead outcomes / s", "description": "Unsigned Solana Pay wallet transactions requested by result; x402 receipts skipped because the purchase email is not deliverable; Services contact-sales requests and their Slack notifications by result. Every writing service is included.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 145}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (service, result) (rate(urnetwork_solana_payment_transactions_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "solana {{service}} {{result}}"}, {"refId": "B", "expr": "sum by (service) (rate(urnetwork_x402_receipts_refused_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "x402 receipt refused {{service}}"}, {"refId": "C", "expr": "sum by (service, result) (rate(urnetwork_services_lead_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "lead {{service}} {{result}}"}, {"refId": "D", "expr": "sum by (service, result) (rate(urnetwork_services_lead_notify_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "lead notify {{service}} {{result}}"}]},
    {"id": 43, "type": "timeseries", "title": "account message sends / s by channel and result", "description": "SES email and Pinpoint SMS calls for account messages, each bounded by its send timeout, across every sending service.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 145}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (service, channel, result) (rate(urnetwork_account_message_sends_total{env=\"$env\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{service}} {{channel}} {{result}}"}]},
    {"id": 44, "type": "timeseries", "title": "reserved upload admission startup failure by process", "description": "1 when the configured reserved validator upload admission could not start. Reserved uploads are then refused while every other route serves.", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 153}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "max by (host, block, instance) (urnetwork_api_reserved_upload_startup_failed{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"})", "legendFormat": "{{host}} {{block}} {{instance}}"}]},
    {"id": 45, "type": "timeseries", "title": "invalid hosted proxy performance profiles / s", "description": "Initial performance profiles of hosted proxy devices that connect refuses, caught by this service: refused on POST /network/auth-client, or a stored config read back in auto.", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 153}, "datasource": {"type": "prometheus", "uid": "warp-mimir"}, "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}}, "targets": [{"refId": "A", "expr": "sum by (source) (rate(urnetwork_proxy_invalid_performance_profiles_total{env=\"$env\",service=\"api\",block=~\"$block\",host=~\"$host\",instance!=\"\"}[$__rate_interval]))", "legendFormat": "{{source}}"}]}
  ]
